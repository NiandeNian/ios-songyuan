+/// A heavy frame cannot keep every recorded command buffer warm forever. Both levels share
+/// one bound, detached handles are disjoint from those reused, and another trim detaches none.
+#[test]
+fn excess_completed_buffers_leave_one_bounded_warm_set() {
+    let primary = vk::CommandBufferLevel::PRIMARY;
+    let secondary = vk::CommandBufferLevel::SECONDARY;
+    let mut pool = CommandPool::new(vk::CommandPool::from_raw(1), 0);
+    for n in 0..(COMMAND_BUFFERS - 1) as u64 {
+        pool.made(primary, vk::CommandBuffer::from_raw(n + 1));
+    }
+    for n in 0..80u64 {
+        pool.made(secondary, vk::CommandBuffer::from_raw(1000 + n));
+    }
+    let excess = pool.excess();
+    assert_eq!(excess.len(), 79);
+    assert_eq!(excess[0], vk::CommandBuffer::from_raw(1001));
+    pool.reset_handed();
+    for n in 0..(COMMAND_BUFFERS - 1) as u64 {
+        assert_eq!(pool.reuse(primary), Some(vk::CommandBuffer::from_raw(n + 1)));
+    }
+    assert_eq!(pool.reuse(primary), None);
+    assert_eq!(pool.reuse(secondary), Some(vk::CommandBuffer::from_raw(1000)));
+    assert_eq!(pool.reuse(secondary), None);
+    assert!(pool.excess().is_empty());
 }
 
