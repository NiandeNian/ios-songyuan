 /// The device itself, released with its own functions (`vkDestroyDevice`).
 pub(crate) struct WholeDevice;
+
+/// Completed command buffers detached from a spare pool. Trimming after their free also
+/// releases driver-side recycled command buffers; freeing alone may only move them to a cache.
+pub(crate) struct CommandBuffers<'a> {
+    pub(crate) pool: vk::CommandPool,
+    pub(crate) buffers: &'a [vk::CommandBuffer],
+}
+
+impl Released for CommandBuffers<'_> {
+    const CALL: Call = Call::FreeCommandBuffers;
+
+    unsafe fn destroy(self, device: &ash::Device, _: Door) {
+        // SAFETY: the caller owns this idle pool exclusively; all listed buffers completed.
+        unsafe {
+            device.free_command_buffers(self.pool, self.buffers);
+            device.trim_command_pool(self.pool, vk::CommandPoolTrimFlags::empty());
+        }
+        exit_guard::called(Call::TrimCommandPool);
+    }
+}
 
