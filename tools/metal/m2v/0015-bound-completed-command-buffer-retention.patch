+    /// Detach excess handles only after the pool's work completed. The caller frees these
+    /// through the release door before any of the kept handles is recorded again.
+    pub(super) fn excess(&mut self) -> Vec<vk::CommandBuffer> {
+        let mut room = COMMAND_BUFFERS;
+        let mut excess = Vec::new();
+        for buffers in &mut self.made {
+            let keep = buffers.len().min(room);
+            room -= keep;
+            excess.extend(buffers.drain(keep..));
+        }
+        excess
