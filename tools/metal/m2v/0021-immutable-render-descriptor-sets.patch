+//! Immutable render descriptor sets already written in this encoder. The pool belongs to its
+//! command buffer, and successful draws retain every named object until completion. A hit reuses
+//! the set without updating it: earlier draws therefore keep their own descriptor contents.
+//! Only exact Vulkan descriptors match; buffer contents, push constants and heap-set updates
+//! still follow the ordinary draw path. A rebind changes the resolved handles or offsets, and
+//! replay starts a new encoder and an empty memo.
+
+/// A few recurring materials, bounded independently of the number of draws or bound resources.
+const SETS: usize = 4;
+/// Larger sets keep the ordinary allocation path, bounding both lookup work and stored keys.
+const WRITES: usize = 32;
+
+/// Everything written to one binding/array element of set zero. Raw Vulkan handles are identities,
+/// not hashes: the encoder's successful draws keep them alive for the memo's whole lifetime.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct Descriptor {
+    pub(super) binding: u32,
+    pub(super) element: u32,
+    pub(super) kind: i32,
+    pub(super) value: Value,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Value {
+    Buffer {
+        handle: u64,
+        offset: u64,
+        range: u64,
+    },
+    Image {
+        view: u64,
+        sampler: u64,
+        layout: i32,
+    },
+    Texel(u64),
+}
+
+struct Entry<S> {
+    layout: u64,
+    writes: Vec<Descriptor>,
+    set: S,
+}
+
+/// FIFO replacement suffices: the common one/two-material case never replaces an entry. No
+/// recency bookkeeping or key allocation is done on a hit. Stored key vectors are reused.
+pub(super) struct Memo<S> {
+    entries: [Option<Entry<S>>; SETS],
+    next: usize,
+}
+
+impl<S> Default for Memo<S> {
+    fn default() -> Self {
+        Self {
+            entries: std::array::from_fn(|_| None),
+            next: 0,
+        }
+    }
+}
+
+impl<S: Copy> Memo<S> {
+    pub(super) fn find(
+        &self,
+        layout: u64,
+        writes: impl ExactSizeIterator<Item = Descriptor> + Clone,
+    ) -> Option<S> {
+        if writes.len() > WRITES {
+            return None;
+        }
+        self.entries.iter().flatten().find_map(|entry| {
+            (entry.layout == layout && entry.writes.iter().copied().eq(writes.clone()))
+                .then_some(entry.set)
+        })
+    }
+
+    /// Called only after every refusal point, when the draw retains its objects. Remembering a
+    /// failed draw could let its handles die and be recycled while the key was still stored.
+    pub(super) fn remember(
+        &mut self,
+        layout: u64,
+        writes: impl ExactSizeIterator<Item = Descriptor>,
+        set: S,
+    ) {
+        if writes.len() > WRITES {
+            return;
+        }
+        match &mut self.entries[self.next] {
+            Some(entry) => {
+                // The memo is optional. If key storage cannot grow, leave the old entry
+                // intact and keep the newly written set on the ordinary draw path.
+                if entry
+                    .writes
+                    .try_reserve(writes.len().saturating_sub(entry.writes.len()))
+                    .is_err()
+                {
+                    return;
+                }
+                entry.layout = layout;
+                entry.set = set;
+                entry.writes.clear();
+                entry.writes.extend(writes);
+            }
+            slot @ None => {
+                let mut key = Vec::new();
+                if key.try_reserve(writes.len()).is_err() {
+                    return;
+                }
+                key.extend(writes);
+                *slot = Some(Entry {
+                    layout,
+                    set,
+                    writes: key,
+                })
+            }
+        }
+        self.next = (self.next + 1) % SETS;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn image() -> Descriptor {
+        Descriptor {
+            binding: 0,
+            element: 0,
+            kind: 1,
+            value: Value::Image {
+                view: 7,
+                sampler: 9,
+                layout: 1,
+            },
+        }
+    }
+
+    #[test]
+    fn every_descriptor_field_and_layout_are_part_of_the_key() {
+        let mut memo = Memo::default();
+        let descriptor = image();
+        memo.remember(11, [descriptor].into_iter(), 37);
+        assert_eq!(memo.find(11, [descriptor].into_iter()), Some(37));
+        assert_eq!(memo.find(12, [descriptor].into_iter()), None);
+        for different in [
+            Descriptor {
+                binding: 1,
+                ..descriptor
+            },
+            Descriptor {
+                element: 1,
+                ..descriptor
+            },
+            Descriptor {
+                kind: 2,
+                ..descriptor
+            },
+            Descriptor {
+                value: Value::Image {
+                    view: 8,
+                    sampler: 9,
+                    layout: 1,
+                },
+                ..descriptor
+            },
+            Descriptor {
+                value: Value::Image {
+                    view: 7,
+                    sampler: 10,
+                    layout: 1,
+                },
+                ..descriptor
+            },
+            Descriptor {
+                value: Value::Image {
+                    view: 7,
+                    sampler: 9,
+                    layout: 2,
+                },
+                ..descriptor
+            },
+            Descriptor {
+                value: Value::Texel(7),
+                ..descriptor
+            },
+        ] {
+            assert_eq!(memo.find(11, [different].into_iter()), None);
+        }
+        assert_eq!(memo.find(11, [descriptor, descriptor].into_iter()), None);
+    }
+
+    #[test]
+    fn buffer_ranges_rebinds_and_write_order_do_not_collide() {
+        let mut memo = Memo::default();
+        let a = Descriptor {
+            value: Value::Buffer {
+                handle: 7,
+                offset: 16,
+                range: 64,
+            },
+            ..image()
+        };
+        let b = image();
+        memo.remember(11, [a, b].into_iter(), 37);
+        assert_eq!(memo.find(11, [a, b].into_iter()), Some(37));
+        assert_eq!(memo.find(11, [b, a].into_iter()), None);
+        for value in [
+            Value::Buffer {
+                handle: 8,
+                offset: 16,
+                range: 64,
+            },
+            Value::Buffer {
+                handle: 7,
+                offset: 32,
+                range: 64,
+            },
+            Value::Buffer {
+                handle: 7,
+                offset: 16,
+                range: 128,
+            },
+        ] {
+            assert_eq!(
+                memo.find(11, [Descriptor { value, ..a }, b].into_iter()),
+                None
+            );
+        }
+    }
+
+    #[test]
+    fn replacement_is_bounded_and_large_sets_do_not_enter_the_memo() {
+        let mut memo = Memo::default();
+        for i in 0..SETS as u64 + 1 {
+            memo.remember(i, [image()].into_iter(), i + 10);
+        }
+        assert_eq!(memo.find(0, [image()].into_iter()), None);
+        for i in 1..SETS as u64 + 1 {
+            assert_eq!(memo.find(i, [image()].into_iter()), Some(i + 10));
+        }
+        memo.remember(90, [image(); WRITES + 1].into_iter(), 100);
+        assert_eq!(memo.find(90, [image(); WRITES + 1].into_iter()), None);
+        assert_eq!(memo.find(4, [image()].into_iter()), Some(14));
+    }
+}
