+                handle: info.buffer.as_raw(),
+                offset: info.offset,
+                range: info.range,
+            },
+            Info::Image(info) => Value::Image {
+                view: info.image_view.as_raw(),
+                sampler: info.sampler.as_raw(),
+                layout: info.image_layout.as_raw(),
+            },
+            Info::Texel(view) => Value::Texel(view.as_raw()),
+        };
+        Descriptor {
+            binding: self.binding,
+            element: self.element,
+            kind: self.ty.as_raw(),
+            value,
+        }
+    }
+}
