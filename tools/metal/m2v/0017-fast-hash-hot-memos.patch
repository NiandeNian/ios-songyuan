-    /// Each entry's number: the stamp of the insert that kept it.
-    numbers: HashMap<K, u64>,
+    /// Each entry's number: the stamp of the insert that kept it. The runtime's own keys
+    /// (variant and plan shapes), looked up at every draw, take the runtime's fast hasher
+    /// (`key_hash.rs`) over the standard one.
+    numbers: KeyMap<K, u64>,
     /// The entries, by number.
     entries: BTreeMap<u64, Slot<K, V>>,
     /// Each entry's number by its last use, oldest first.
@@ -61,7 +64,7 @@
