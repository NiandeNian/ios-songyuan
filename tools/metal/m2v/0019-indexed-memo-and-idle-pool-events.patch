+/// Measure the hot memo paths independently of shader compilation or driver time. Run in
+/// release mode with `--ignored --nocapture`; timing is reported, never asserted.
+#[test]
+#[ignore = "release-mode memo lookup measurement"]
+fn memo_lookup_cost() {
+    use std::hint::black_box;
+    use std::time::Instant;
+
+    const LOOKUPS: u64 = 2_000_000;
+    for size in [32, 256, 4096] {
+        let mut memo = Lru::counted(size);
+        for key in 0..size as u64 {
+            memo.insert(key, key, 1);
+        }
+        let start = Instant::now();
+        for step in 0..LOOKUPS {
+            black_box(memo.get(black_box(&(step % size as u64))));
+        }
+        println!(
+            "memo {size} rotating key: {:.1} ns/hit",
+            start.elapsed().as_nanos() as f64 / LOOKUPS as f64
+        );
+        let at = memo.get_with_at(&0).expect("entry retained").0;
+        let start = Instant::now();
+        for _ in 0..LOOKUPS {
+            black_box(memo.get_at(black_box(at)));
+        }
+        println!(
+            "memo {size} repeated handle: {:.1} ns/hit",
+            start.elapsed().as_nanos() as f64 / LOOKUPS as f64
+        );
+        assert_eq!(memo.footprint(), (size as u64, size));
+    }
+}
 
