+/// Idle pools share one warm budget, rather than multiplying it by the number of pools.
+/// Only detached completed handles are released; every pool and its queue family survive.
+#[test]
+fn idle_pools_share_one_completed_handle_budget() {
+    let primary = vk::CommandBufferLevel::PRIMARY;
+    let secondary = vk::CommandBufferLevel::SECONDARY;
+    let mut pools = Vec::new();
+    for n in 0..3u64 {
+        let mut pool = CommandPool::new(vk::CommandPool::from_raw(n + 1), n as u32);
+        for index in 0..COMMAND_BUFFERS as u64 {
+            pool.made(
+                if index % 2 == 0 { primary } else { secondary },
+                vk::CommandBuffer::from_raw(1 + n * 1000 + index),
+            );
+        }
+        pools.push(pool);
+    }
+    let mut room = COMMAND_BUFFERS;
+    let detached: Vec<_> = pools
+        .iter_mut()
+        .map(|pool| pool.excess(&mut room))
+        .collect();
+    assert_eq!(room, 0);
+    assert!(detached[0].is_empty());
+    assert_eq!(detached[1].len(), COMMAND_BUFFERS);
+    assert_eq!(detached[2].len(), COMMAND_BUFFERS);
+    for (index, pool) in pools.iter_mut().enumerate() {
+        assert_eq!(pool.raw, vk::CommandPool::from_raw(index as u64 + 1));
+        pool.reset_handed();
+        let mut reused = 0;
+        for level in [primary, secondary] {
+            while let Some(handle) = pool.reuse(level) {
+                assert!(!detached
+                    .iter()
+                    .flatten()
+                    .any(|released| *released == handle));
+                reused += 1;
+            }
+        }
+        assert_eq!(reused, if index == 0 { COMMAND_BUFFERS } else { 0 });
+    }
+    assert_eq!(
+        take_command_pool(&mut pools, 2)
+            .expect("family retained")
+            .raw,
+        vk::CommandPool::from_raw(3)
+    );
 }
 
