 impl Spares {
+    /// Reclaim excess handles from every completed pool before an encoding allocation grows
+    /// another pool. Keeping only the next pool bounded leaves other idle pools' command
+    /// streams resident during a heavy frame. The lock excludes takers and returners while
+    /// Vulkan frees the detached handles, preserving each pool's external synchronization.
+    pub(super) fn reclaim_completed(&self, device: &DeviceShared) {
+        if exit_guard::in_section() {
+            return;
+        }
+        let mut room = COMMAND_BUFFERS;
+        for pool in lock(&self.command_pools).iter_mut() {
+            let excess = pool.excess(&mut room);
+            if excess.is_empty() {
+                continue;
+            }
+            // SAFETY: only completed or unsubmitted pools are returned here. The spares lock
+            // prevents another thread from taking, resetting or recording in this pool.
+            unsafe {
+                release_in_section(
+                    device,
+                    release::CommandBuffers {
+                        pool: pool.raw,
+                        buffers: &excess,
+                    },
+                );
+            }
+            device.counts.command_buffers_trimmed(excess.len() as u64);
+            device.counts.idle_command_buffers_trimmed(excess.len() as u64);
+        }
+    }
