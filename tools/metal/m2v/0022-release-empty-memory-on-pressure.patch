+    /// Release empty spares of every memory type before retrying a failed allocation. The
+    /// allocator lock excludes new placements while they are removed. Live resources and
+    /// pending commands retain their placements, so none can name one of these empty blocks.
+    fn release_empty(&mut self, device: &ash::Device) -> bool {
+        let mut released = 0;
+        for pool in &mut self.pools {
+            for block in pool.drain_empty() {
+                released += 1;
+                self.reclaimed_bytes += block.size;
+                // SAFETY: no placement remains, as for the existing empty-block release.
+                unsafe { block.release(device) };
+            }
+        }
+        self.reclaimed_empty += released;
+        released != 0
+    }
