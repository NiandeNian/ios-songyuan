+#[test]
+fn pressure_releases_only_empty_spares_and_preserves_live_block_indices() {
+    let mut pool: Pool<&str> = Pool::default();
+    let empty = pool.add(256, false, "empty", 0);
+    let live = pool.add(256, false, "live", 64);
+    let dedicated = pool.add(1000, true, "dedicated", 1000);
+    assert_eq!(pool.drain_empty().collect::<Vec<_>>(), ["empty"]);
+    assert_eq!(pool.blocks(), 2);
+    assert_eq!(pool.payload(live), Some(&"live"));
+    assert_eq!(pool.payload(dedicated), Some(&"dedicated"));
+    assert_eq!(pool.payload(empty), None);
+    assert_eq!(pool.place(192, 1), Some((live, 64)));
+    assert_eq!(pool.drain_empty().next(), None);
+    assert_eq!(pool.release(live, 0, 64), None);
+    assert_eq!(pool.release(live, 64, 192), None);
+    assert_eq!(pool.drain_empty().collect::<Vec<_>>(), ["live"]);
+    assert_eq!(pool.release(dedicated, 0, 1000), Some("dedicated"));
+    assert_eq!(pool.add(128, false, "reused-slot", 1), empty);
+}
