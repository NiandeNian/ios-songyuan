+/* Static Pro Max style mask, after the GPU fence and before either display path.
+ * Coordinates scale with the composed frame; no UI process or input handler. */
+static void
+nezha_draw_capsule(SweetSurface *s)
+{
+	if (!s->memory || s->pixelFormat != 0x42475241 || s->bytesPerElement != 4 ||
+	    s->elementWidth != 1 || s->elementHeight != 1 || s->width < 375 ||
+	    s->bytesPerRow < (uint64_t)s->width * 4 ||
+	    (uint64_t)s->offset + (uint64_t)s->bytesPerRow * s->height > s->memory->getLength()) {
+		return;
+	}
+	const uint32_t w = s->width * 110 / 375, h = s->width * 32 / 375;
+	const uint32_t x0 = (s->width - w) / 2, y0 = s->width * 14 / 375 - (s->width * 2 + 600) / 1200;
+	uintptr_t pixels = s->kernelAddress();
+	if (!pixels || y0 + h > s->height) {
+		return;
+	}
+	for (uint32_t y = 0; y < h; y++) {
+		const int64_t dy = 2 * (int64_t)y + 1 - h;
+		uint32_t inset = 0;
+		while ((2 * (int64_t)inset + 1 - h) * (2 * (int64_t)inset + 1 - h) + dy * dy > (int64_t)h * h) {
+			inset++;
+		}
+		uint32_t *row = (uint32_t *)(pixels + s->offset + (uint64_t)(y0 + y) * s->bytesPerRow);
+		for (uint32_t x = x0 + inset; x < x0 + w - inset; x++) {
+			row[x] = 0xff000000;
+		}
+		flush_dcache((vm_offset_t)(row + x0), w * 4, FALSE);
+	}
+}
