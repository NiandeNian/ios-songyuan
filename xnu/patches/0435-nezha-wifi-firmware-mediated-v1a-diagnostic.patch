+static int wifi_peer_metadata_diagnostic(void)
+{
+    int enabled = 0;
+    (void)PE_parse_boot_argn("nezha_wifi_fw_diag", &enabled, sizeof(enabled));
+    if (enabled != 1) return 0;
+    /* Fixed to the collected Nezha amss20 image. A PCIe read of this SRAM
+     * returned all ones followed by memss_security: never repeat that probe.
+     * Ask the running firmware instead, after WMI READY, using ATHDIAG space 0. */
+    uint32_t getter = 0;
+    int err = peach_wlfw_read_word(&wifi_wlfw, 0x015598b4, 0, &getter);
+    if (err) {
+        printf("NEZHA WIFI: V1A QMI readback unavailable %d result/error %u/%u; proof pending\n",
+            err, wifi_wlfw.result, wifi_wlfw.remote_error);
+        return wifi_fault || wifi_host.poisoned || wifi_wlfw.error ? err : 0;
+    }
+    printf("NEZHA WIFI: V1A QMI readback [0x015598b4]=%#x selected %u expected 0x01e2be08 match %u\n",
+        getter, wifi_wmi.peer_metadata_version,
+        wifi_wmi.peer_metadata_version == 2 && getter == 0x01e2be08);
+    return 0;
+}
