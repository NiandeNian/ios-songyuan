+    if (!r || !r->prepared || r->started || !r->lmac || !h) return PeachMhiInvalid;
+    if (r->error) return r->error;
+    if (r->kind == PeachSrngRxBuffer) {
+        if (!((id == 0 && type == PeachHttSwToHw) || (id == 5 && type == PeachHttSwToSw)))
