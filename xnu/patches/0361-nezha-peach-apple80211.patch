+static AppleChannel channel(unsigned frequency, unsigned flags)
+{
+    AppleChannel c = {1, frequency == 2484 ? 14 : frequency < 2500 ?
+        (frequency - 2407) / 5 : (frequency - 5000) / 5,
+        2u | (frequency < 2500 ? 8u : 16u) | (!(flags & 1) ? 0x80u : 0) |
+        ((flags & 2) ? 0x100u : 0)};
+    return c;
