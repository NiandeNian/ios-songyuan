+/*
+ * NEZHA speaker amplifiers: TI TAS25xx, two chips on QUPv3 wrapper 3 SE0 I2C
+ * (0x01980000, Android i2c-13) - the same controller the 17 Pro's CS35L43s use.
+ * Per this board's live device tree (tas25xx@4a under i2c@1980000):
+ *   - channel 0 at 0x4a, released by reset-gpio TLMM GPIO 54;
+ *   - channel 1 at 0x48, released by reset-gpio2 TLMM GPIO 56;
+ *   - shared ti,irq-gpio GPIO 47 (nothing listens to it here);
+ *   - shutdown lines spkr_02_sd_n = GPIO 76, spkr_13_sd_n = GPIO 77
+ *     (active = output high; idle = pull-down input; Android drives them
+ *     high through the pinctrl states when the speaker path assembles).
+ * Android's tas25xx_dlkm talks 8-bit book:page:register, one byte per write;
+ * the collected trace is device/private/phone/wifi-audio-bootlog.txt and the
+ * authoritative reset sequence comes from disassembling this board's own
+ * tas25xx_dlkm.ko (tas25xx_hw_reset: both resets low, msleep 20 ms, both
+ * high, usleep 10 ms; XRESET is active low).
+ * Mode 1 samples GPIO47 and reads the two chips. Mode 2 additionally loads
+ * the phone's original tismartpa_driver_tuning.bin, initializes each chip,
+ * and plays for 10 seconds after the Nezha ADSP speaker graph is running.
+ * No new PMIC votes are needed: both chips ACK before any audio rail vote.
+ * Historical err 22 reports were rejected combined I2C calls, not NACKs.
+ */
+#if defined(PANDORA)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/kalloc.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern uint8_t *pandora_fw_file(const char *, uint32_t *);
+void pandora_amp_tas_init(void);
+void pandora_amp_tas_tdm(int);
+bool pandora_amp_tas_live(void);
+int pandora_amp_tas_io(int, unsigned);
