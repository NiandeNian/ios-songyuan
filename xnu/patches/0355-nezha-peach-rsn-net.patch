+#ifndef PEACH_RSN_H
+#define PEACH_RSN_H
+#include "PeachStation.h"
+
+#define PEACH_RSN_PACKET 640u
+#define PEACH_RSN_QUEUE 4u
+enum { PeachRsnIdle, PeachRsnM1, PeachRsnM3, PeachRsnKeys,
+       PeachRsnConnected, PeachRsnFailed };
