+/*
+ * NEZHA camera subsystem: Stage C-1/C-2a/C-2b-p/C-2b-w0 read-only diagnostics,
+ * plus the Stage C-2b-w1 GDSC/AHB bring-up probe (writes three CAMCC
+ * registers, verifies each step, then rolls them all back).
+ *
+ * What this does and does NOT do (so the next agent is not misled):
+ *
+ *   YES (mode 1):
+ *     - Map CAMCC / BDISTMCLKCC / TLMM / CCI0-2 (never GCC: other drivers own that
+ *       aperture; mapping it twice and unmapping raced the GPU/touch workers and
+ *       restarted the kernel -- see the control/no-control A/B in the log).
+ *     - Read the CCI master timing registers per DT fast-mode values, and each
+ *       sensor's strap: cell index, CCI master, CSIPHY index, MCLK + reset TLMM
+ *       pin numbers (DT gpios), and its RPMh / GPIO rail voltages.
+ *     - Print the CCI pin mux state (TLMM CTL for all 12 CCI SDA/SCL pins and
+ *       the 4 sensor MCLK/reset pins).
+ *     - C-2b-p: read the upstream Kaanapali CAMCC / CAMBISTMCLKCC clock offsets
+ *       one register per printf, after every C-2a line has been printed.
+ *     - C-2b-w0: read CCI0 hw-version / IRQ / queue status and CAMCC CFG_GDSCR
+ *       read-only, so the pre-write state is in the same log.
+ *     - C-2b-w1: enable TITAN_TOP GDSC (0x21334), CORE_AHB (0x21348) and
+ *       CAM_TOP_AHB (0x2137c), each with a bounded status poll and A/B prints,
+ *       then roll back in reverse order and bounded-poll POWER_DOWN_COMPLETE.
+ *       These were the first MMIO writes in this file. See
+ *       CAMERA_C2B_WRITE_SEQUENCE.md §3/§5 and CAMERA_C2BW1_RESULT.md §6.
+ *       Verdict compares GDSCR *control bits only* ([23:0]); the high byte is
+ *       live hardware status and never reads back what was written. A CORE_AHB
+ *       enable bit that does not stick is printed as an unresolved observation,
+ *       never silently folded into a success.
+ *     - C-2b-w2: while that GDSC is still up, read the CCI0 RCG state
+ *       (CMD/CFG/M/N/D) and write ONLY the CCI0 branch CBCR BIT(0), poll
+ *       CLK_OFF, print its own A/B result and restore the CBCR. On this board
+ *       that write ALSO clears CMD_ROOT_OFF in hardware (HW_CLK_CTRL mode);
+ *       the RCG does NOT stay parked, and its clock is XO/div1, not 37.5 MHz
+ *       -- see CAMERA_C2BW2_RESULT.md §3. No PLL, RCG rate, rail, GPIO or CCI
+ *       queue word is touched.
+ *     - C-2b-w3: read-only. Print the full CMD_RCGR / CFG_RCGR before, after
+ *       and after rollback, check whether the root re-parked, snapshot the CCI0
+ *       controller registers while the branch is on, and cross-check CMD_RCGR
+ *       once the GDSC is off. A "LEFTOVER" result means the probe changed CCI0
+ *       RCG state and must be reported as such, not hidden by restored=yes.
+ *   NO:
+ *     - It never votes RPMh rails, never drives the GPIO regulators, never
+ *       clocks the sensors, never writes a PLL, never writes RCG M/N/D registers, never issues a
+ *       CCI transaction, never touches CSIPHY / CSID / IFE, never reserves
+ *       SMMU, never unmaps camera regions.
+ *     - C-2b-w2 is the FIRST exception to "never enables a CCI branch": it
+ *       writes CCI0 CBCR (0x21268) BIT(0), polls CLK_OFF, prints the A/B and
+ *       restores the exact pre-write value. No I2C transaction follows.
+ *     - C-2b-w5 is the FIRST exception to "never writes an RCG": it switches
+ *       the CCI0 RCG source from XO to PLL0_OUT_EVEN/16 (37.5 MHz) by writing
+ *       CFG_RCGR (SRC_SEL=2 + SRC_DIV=16, HW_CLK_CTRL kept) and CMD_RCGR
+ *       CMD_UPDATE, polls, then rolls the RCG back in reverse and re-parks the
+ *       root. It still writes no PLL, no RCG M/N, no rail/GPIO/CCI transaction.
+ *     - C-2b-w6 diagnoses w5's CMD_UPDATE non-ack. It writes the same CCI0
+ *       RCG registers (CFG_RCGR / CMD_RCGR / CBCR) to test four hypotheses
+ *       (explicit CMD_UPDATE clear, CMD_UPDATE without HW_CLK_CTRL, branch
+ *       off->on reload, PLL0 output-enable dump) and rolls back in reverse.
+ *       It still writes no PLL, no RCG M/N, no rail/GPIO/CCI transaction.
+ *   Mode 2 is identical to mode 1 for now: per-sensor address + power
+ *   bring-up is gated on vendor data the board DT does not carry. Do not
+ *   "extend" this driver further without filling those unknowns first.
+ *
+ * Why Stage C-1 is a diagnostic and not a "sensor probe":
+ *
+ *   The live DT (device/private/phone/live.dtb, fetched 2026-10-21) describes
+ *   the camera subsystem as follows. It is the ONLY hardware source here;
+ *   do not trust generic IMX800 assumptions.
+ *
+ *     - Six sensors/actuators/EEPROMs are children of THREE CCI
+ *       controllers, not of the QUPv3 GENI buses this tree already drives
+ *       (pandora_touch / pandora_amp_tas use wrapper 4 / 3 SE0):
+ *         CCI0  qcom,cci @ 0x941b000 (reg 0x1000, CCI0, INT 426)
+ *          + qcom,cam-sensor0 (wide)   cci-master=1, csiphy0, MCLK gpio89,  rst gpio106
+ *          + qcom,actuator0 / eeprom0  (same gpios)
+ *          + qcom,cam-sensor3 (tele)   cci-master=0, csiphy3, MCLK gpio92,  rst gpio105
+ *          + qcom,actuator3 / zoom3 / eeprom3
+ *         CCI1  qcom,cci @ 0x941c000 (INT 427) -- no sensor children in DT
+ *         CCI2  qcom,cci @ 0x941d000 (INT 428) -- no sensor children in DT
+ *       CCI clock: 37.5 MHz (DT clock-rates 37500000), source cci_*_clk_src
+ *       from CAMCC (clock-controller@0x956d000, qcom,canoe-camcc).
+ *       Sensor clock: "cam_clk" 19.2 MHz (DT clock-rates 0x124f800) from
+ *       BDISTMCLKCC (clock-controller@0x1760000, qcom,canoe-cambistmclkcc).
+ *       CCI I2C pins (TLMM, DT pinctrl):
+ *         CCI0 master 0: SDA gpio109 / SCL gpio110
+ *         CCI0 master 1: SDA gpio111 / SCL gpio112
+ *         CCI1 master 0: SDA gpio113 / SCL gpio114, master 1: gpio107 / gpio160
+ *         CCI2 master 0: SDA gpio108 / SCL gpio149, master 1: gpio115 / gpio116
+ *
+ *     - The sensor rails are split across GPIO regulators and RPMh VRM.
+ *       Wide (sensor0): cam_vana / cam_v_custom1 / cam_vdig / cam_vaf are
+ *       GPIO regulators (TLMM gpios 107 / 116), cam_vio is RPMh L5M_E1
+ *       (1.8 V), cam_bob / cam_bob2 are RPMh B1B_E0 / B2B_E0 BOBs.
+ *       Tele (sensor3): cam_vana / cam_vdig are GPIO regulators (gpio113),
+ *       cam_vio is L5M_E1, bob2 is B2B_E0, vaf / custom1 are L5N_E1 / L3N_E1.
+ *       (Verified by resolving each *-supply phandle to its regulator node.)
+ *
+ *     - The unknowns that make a real probe unsafe to guess:
+ *       * Sensor I2C slave addresses are NOT in this DT (no slave-addr
+ *         property on any cam-sensor / actuator / eeprom node). They live in
+ *         the vendor camera config. Without them, "read ID at 0x1a" (as the
+ *         CAMERA_DRIVER_HANDOFF skeleton suggested) is a coin flip.
+ *       * The sensor model is not named (cell-index 0 = "wide", 3 = "tele"
+ *         by position DT only). Do not assume IMX800 and write its init
+ *         table blindly.
+ *       * CCI master programming (TRDHLD/TBUF/THD, TSU, TLOW, THIGH per
+ *         master), CAMCC clock branch enables, and the BDISTMCLKCC cam_clk
+ *       RCG values are not in this tree yet; gcc-kaanapali equivalents for
+ *       the camera CCs must be read from the right clock driver first.
+ *       * CSIPHY V2.4.0 (6 lanes 0x9523000..0x952d000), CSID1080
+ *       (0x9253000..0x9273000), IFE (0x9151000..) and cam_smmu are Stage
+ *         C-2+ and are deliberately untouched here.
+ *
+ *   C-2a adds the per-master CCI timing-register dump (offsets 0x100..0x210 from
+ *   upstream camss-cci.c, validated field-for-field against the live DT
+ *   qcom,i2c_fast_mode children). It is still read-only and powers nothing.
+ *   C-2b-p adds a read-only probe of the upstream Kaanapali CAMCC /
+ *   CAMBISTMCLKCC clock offsets (table and evidence in
+ *   CAMERA_C2B_CLOCK_INPUTS.md). "canoe" and "kaanapali" are the same SM8850;
+ *   this board's DT clock IDs (CCI 14/15..18/19, MCLK 2/6/8/10), the 37.5 MHz
+ *   and 19.2 MHz rates and the /proc/iomem windows all match the upstream
+ *   driver. The probe is the step that confirms those offsets are readable
+ *   here; it still writes nothing.
+ *
+ *   C-2b-w1 is deliberately narrow. This board's DT puts CCI0/1/2 in the
+ *   CAM_CC_TITAN_TOP_GDSC power domain (power-domains = <&camcc 5>) while the
+ *   CAMCC node itself has no parent power-domain, so bringing up the GDSC and
+ *   the two AHB branches needs no RPMh rail vote and touches no sensor pin.
+ *   Upstream gdsc.c polls CFG_GDSCR (0x21338) bit 16 for POWER_UP_COMPLETE,
+ *   NOT GDSCR bit 31; clk-branch.c polls CBCR bit 31 (CLK_OFF) clearing,
+ *   except CORE_AHB which is BRANCH_HALT_DELAY and has no halt bit.
+ *   Full C-2b (power + CCI read-ID) stays gated: RPMh vote sequencing,
+ *   MCLK/reset mux values, the CCI address-then-read encoding, the RCG rate
+ *   handshake and the real sensor chip-ID registers are still unresolved.
+ *
+ * Boot args:
+ *   pandora_camera=<level>   default 0 (off). 1 or 2 = run the diagnostics
+ *   in a short-lived thread, including the C-2b-w1 write/rollback probe.
+ *   Nothing else is gated by this file.
+ *   Use the 11-04 user-verified cmdline baseline plus this flag
+ *   (cmdline-good-plus-camera-reboot90.txt, 603/608 B). The older camera-only
+ *   cmdline (cmdline-camera-reboot90.txt) crash-loops SpringBoard at 49 s for
+ *   unrelated reasons -- see DESKTOP_BOOT_RECOVERY.md. A single-variable A/B
+ *   confirmed this flag is compatible with the good cmdline (1 exec / 0 CRASH).
+ *   Do not report camera results from a boot that never reached the desktop.
+ *   pandora_camera_delay=<s> seconds to wait before mapping anything, so a
+ *   rail that settles late can be told from a rail nobody enables in iOS.
+ *   pandora_steps=<ms>       before the first access to each MMIO region and
+ *   before each C-2b-w1 write group, print its name and wait ms (as
+ *   pandora_touch). A hang leaves the name of the last attempted step.
+ *
+ * Sources: live DT as above; GCC CAMCC / BDISTMCLKCC register offsets are
+ * NOT yet verified here -- this file only reads CBCR / RCG state registers
+ * through the same GCC offsets the other pandora drivers use for their
+ * wrapper clocks, and labels every CAMCC read as a dump, never a vote.
+ * CCI timing values are the live DT's qcom,i2c_fast_mode child values
+ * (cci-clk-src 0x23c3460; hw-tbuf 0x3e etc.), reproduced in the dump, not
+ * reinterpreted.
+ */
+#if defined(PANDORA)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern kern_return_t thread_terminate(thread_t);
+void pandora_camera_init(void);
+
+/* PC_GCC_PA removed: GCC must not be mapped here (see header note). */
+#define PC_CAMCC_PA   0x0956d000u
+#define PC_BDISTM_PA  0x01760000u
+#define PC_TLMM_PA    0x0f100000u
+#define PC_GPIO(n)    ((uint32_t)(n) * 0x1000u)
+#define PC_CCI_PA(n)  (0x0941b000u + (uint32_t)(n) * 0x1000u)
+#define PC_PRIORITY   92               /* as pandora_touch */
+#define PC_BIT(n)     (1u << (n))
+
+/* CAMCC GDSC / AHB registers used by C-2b-w1. Offsets and bit meanings come
+ * from upstream camcc-kaanapali.c, gdsc.c and clk-branch.c; see
+ * CAMERA_C2B_WRITE_SEQUENCE.md §3. TITAN_TOP_GDSC sets POLL_CFG_GDSCR, so
+ * POWER_UP_COMPLETE is polled in CFG_GDSCR (gdscr + 0x4), not in GDSCR. */
+#define PC_GDSCR               0x21334u
+#define PC_CFG_GDSCR           0x21338u
+#define PC_CORE_AHB_CBCR       0x21348u
+#define PC_CAM_TOP_AHB_CBCR    0x2137cu
+#define PC_GDSC_SW_COLLAPSE    PC_BIT(0)
+#define PC_GDSC_RETAIN_FF      PC_BIT(11)
+#define PC_CFG_GDSC_PWR_DOWN   PC_BIT(15)
+#define PC_CFG_GDSC_PWR_UP     PC_BIT(16)
+
+/* GDSCR software control/config bits are [23:0]: upstream gdsc.c defines
+ * SW_COLLAPSE bit0, HW_CONTROL bit1, SW_OVERRIDE bit2, RETAIN_FF bit11,
+ * RETAIN_PERIPH bit13, RETAIN_MEM bit14, and the CLK_DIS/EN_FEW/EN_REST
+ * wait fields in bits 15..23. Bit 31 is PWR_ON status and bits 24..30 are
+ * hardware status. C-2b-w1 logs show that high byte changing on every access
+ * (0x02 -> 0x6a -> 0xfa -> 0x72) while [23:0] stays 0x22f801; a whole-word
+ * comparison can therefore never report "restored". */
+#define PC_GDSCR_CTRL_MASK     0x00ffffffu
+#define PC_CBCR_ENABLE         PC_BIT(0)
+#define PC_CBCR_CLK_OFF        PC_BIT(31)
+
+/* CCI0 status registers read (never written) by C-2b-w0. */
+#define PC_CCI_HW_VERSION             0x000u
+#define PC_CCI_IRQ_MASK_0             0xc04u
+#define PC_CCI_IRQ_STATUS_0           0xc0cu
+#define PC_CCI_Qn_CUR_WORD_CNT(m, q)  (0x304u + 0x200u * (m) + 0x100u * (q))
+#define PC_CCI_READ_BUF_LEVEL(m)      (0x11cu + 0x100u * (m))
+/* Upstream i2c-qcom-cci.c CCI_I2C_Mm_* offsets, used read-only by w3. */
+#define PC_CCI_SCL_CTL(m)             (0x100u + 0x100u * (m))
+#define PC_CCI_SDA_CTL_0(m)           (0x104u + 0x100u * (m))
+
+/* C-2b-w2. camcc-kaanapali.c: cam_cc_cci_0_clk has halt_reg/enable_reg
+ * 0x21268, BRANCH_HALT, enable_mask BIT(0). Its parent
+ * cam_cc_cci_0_clk_src has cmd_rcgr 0x21250 with cfg_off = 0 (clk-rcg2.c
+ * RCG_CFG_OFFSET), so CFG/M/N/D are +4/+8/+0xc/+0x10. CMD_RCGR bit31 is
+ * CMD_ROOT_OFF; C-2b-p already read 0x80000000 (root off). The RCG's only
+ * frequency entry is CAM_CC_PLL0_OUT_EVEN / 16 = 37.5 MHz, and PLL0 is a
+ * TAYCAN_EKO_T alpha PLL needing its own config + lock sequence. w2 therefore
+ * only READS these offsets and writes the single CCI0 branch CBCR; it never
+ * writes a RCG, a PLL, a rail, a GPIO or a CCI queue word. */
+#define PC_CCI0_CBCR               0x21268u
+#define PC_CCI0_CMD_RCGR           0x21250u
+#define PC_CCI0_CFG_RCGR           0x21254u
+#define PC_CCI0_M_REG              0x21258u
+#define PC_CCI0_N_REG              0x2125cu
+#define PC_CCI0_D_REG              0x21260u
+#define PC_CMD_ROOT_OFF            PC_BIT(31)
+
+/* TAYCAN_ELU PLL0 register offsets from the CAMCC base (cam_cc_pll0.offset=0x0).
+ * These come from clk_alpha_pll_regs[CLK_ALPHA_PLL_TYPE_TAYCAN_EKO_T] (=ELU):
+ * MODE+0x0 OPMCDE+0x4 STATE+0x8 STATUS+0xc L+0x10 ALPHA+0x14 USER_CTL+0x18
+ * USER_CTL_U+0x1c CONFIG_CTL+0x20 CONFIG_CTL_U+0x24 CONFIG_CTL_U1+0x28
+ * TEST_CTL+0x2c TEST_CTL_U+0x30. Used read-only by the w4 snapshot. */
+#define PC_PLL0_MODE              0x000u
+#define PC_PLL0_OPMCDE            0x004u
+#define PC_PLL0_STATE             0x008u
+#define PC_PLL0_STATUS            0x00cu
+#define PC_PLL0_L_VAL             0x010u
+#define PC_PLL0_ALPHA             0x014u
+#define PC_PLL0_USER_CTL          0x018u
+#define PC_PLL0_USER_CTL_U        0x01cu
+#define PC_PLL0_CONFIG_CTL        0x020u
+#define PC_PLL0_CONFIG_CTL_U      0x024u
+#define PC_PLL0_CONFIG_CTL_U1     0x028u
+#define PC_PLL0_TEST_CTL          0x02cu
+#define PC_PLL0_TEST_CTL_U        0x030u
+
+/* C-2b-w5: CCI0 RCG source-switch bit layout, from cached clk-rcg2.c
+ * (lines 27-43). CFG_RCGR = camcc+0x21254, CMD_RCGR = camcc+0x21250.
+ *   CFG_SRC_SEL    [10:8]  (parent_map index; 2 = P_CAM_CC_PLL0_OUT_EVEN)
+ *   CFG_SRC_DIV    [7:0]    (pre_div; hid_width=5 -> mask 0x1f; freq_tbl div=16)
+ *   CFG_MODE       [13:12]  (0 = single-edge / integer)
+ *   CFG_HW_CLK_CTRL [20]    (already set in the running register)
+ *   CMD_UPDATE     [0]      (write 1, poll until the hardware clears it)
+ * cam_cc_cci_0_clk_src: parent_map_1 index 2 = P_CAM_CC_PLL0_OUT_EVEN;
+ * freq_tbl F(37500000, PLL0_OUT_EVEN, 16, 0, 0) -> 600 MHz / 16 = 37.5 MHz.
+ * Force-enable = enabling the CCI0 branch CBCR: HW_CLK_CTRL un-parks the root
+ * (CMD_ROOT_OFF clears), exactly as w2/w3 observed -- no separate PLL or
+ * CMD_ROOT_EN write. See CAMERA_C2BW4_RESULT.md and cached clk-rcg2.c
+ * update_config() (CMD_UPDATE + poll CMD_UPDATE clear). */
+#define PC_CFG_SRC_SEL_MASK    0x00000700u
+#define PC_CFG_SRC_SEL_SHIFT   8u
+#define PC_CFG_SRC_DIV_MASK    0x0000001fu
+#define PC_CFG_MODE_MASK       0x00003000u
+#define PC_CFG_HW_CLK_CTRL     0x00100000u
+#define PC_CMD_UPDATE          0x00000001u
+#define PC_CMD_ROOT_EN         0x00000002u
+
+
+/* Bounded polls: pc_sleep() is millisecond-granular, so 20 x 1 ms is a
+ * deliberately generous bound (upstream uses 2 ms for GDSC and 200 us for a
+ * branch). A generous timeout cannot manufacture a success: the status bit
+ * still has to be observed. */
+#define PC_POLL_STEPS          20u
+
+static vm_offset_t pc_camcc, pc_bdistm, pc_tlmm;
+static vm_offset_t pc_cci[3];
+static int pc_chan;
+static unsigned pc_level;
+static unsigned pc_steps_ms;
+static bool pc_started;
+
+static uint32_t
+pc_rd(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* First write helper in this file. C-2b-w1 uses it on exactly three CAMCC
+ * registers. The trailing read forces the write out before the caller polls a
+ * status bit; no aperture is ever unmapped. */
+static void
+pc_wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile("dmb oshld" ::: "memory");
+	(void)pc_rd(b, o);
+}
+
+static void
+pc_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&pc_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+pc_step(const char *what, uint32_t pa)
+{
+	if (pc_steps_ms) {
+		printf("PANDORA CAMERA: next: first access to %s at %#x\n", what, pa);
+		pc_sleep(pc_steps_ms);
+	}
+}
+
+/* Print one CCI controller's header registers (read-only). CCI register
+ * offsets are not asserted from a spec in this file: the dump prints raw
+ * values at the offsets the other QCOM drivers use, prefixed as raw, so a
+ * later agent can cross-check against camss-cci without this file having
+ * chosen a wrong offset. */
+static void
+pc_cci_dump(unsigned n)
+{
+	vm_offset_t c = pc_cci[n];
+	printf("PANDORA CAMERA: CCI%u @ %#x: 0x000=%#x 0x004=%#x 0x008=%#x 0x00c=%#x "
+	    "0x010=%#x 0x014=%#x 0x018=%#x 0x01c=%#x 0x020=%#x 0x040=%#x 0x080=%#x 0x0c0=%#x\n",
+	    n, PC_CCI_PA(n),
+	    pc_rd(c, 0x000), pc_rd(c, 0x004), pc_rd(c, 0x008), pc_rd(c, 0x00c),
+	    pc_rd(c, 0x010), pc_rd(c, 0x014), pc_rd(c, 0x018), pc_rd(c, 0x01c),
+	    pc_rd(c, 0x020), pc_rd(c, 0x040), pc_rd(c, 0x080), pc_rd(c, 0x0c0));
+	/* Per-master timing (upstream camss-cci.c: SCL_CTL/SDA_CTL_0/1/2/MISC_CTL
+	 * at 0x100 + 0x100*master; each packs two DT fast-mode fields, see the
+	 * header note). Clocked hardware returns the DT values
+	 * (thigh 0x26, tlow 0x38, tsu_sto 0x28, tsu_sta 0x28, tbuf 0x3e, thd_dat
+	 * 0x16, thd_sta 0x23, trdhld 6, tsp 3, stretch 0); unclocked reads 0. */
+	for (unsigned m = 0; m < 2; m++) {
+		uint32_t b = 0x100u + 0x100u * m;
+		printf("PANDORA CAMERA: CCI%u master%u SCL=%#x SDA01=%#x SDA2=%#x MISC=%#x\n",
+		    n, m, pc_rd(c, b), pc_rd(c, b + 4), pc_rd(c, b + 8), pc_rd(c, b + 12));
+	}
+}
+
+static void
+pc_camcc_dump(void)
+{
+	/* Read-only clock state. Offsets below are GCC/CAMCC CBCR-style state
+	 * registers used by the other pandora drivers (CLK_OFF = bit 31).
+	 * No vote is cast here: this file must not change clock state. */
+	printf("PANDORA CAMCC @ %#x: 0x000=%#x 0x004=%#x 0x008=%#x 0x00c=%#x 0x010=%#x 0x014=%#x\n",
+	    PC_CAMCC_PA,
+	    pc_rd(pc_camcc, 0x000), pc_rd(pc_camcc, 0x004), pc_rd(pc_camcc, 0x008),
+	    pc_rd(pc_camcc, 0x00c), pc_rd(pc_camcc, 0x010), pc_rd(pc_camcc, 0x014));
+	printf("PANDORA BDISTM @ %#x: 0x000=%#x 0x004=%#x 0x008=%#x 0x00c=%#x\n",
+	    PC_BDISTM_PA,
+	    pc_rd(pc_bdistm, 0x000), pc_rd(pc_bdistm, 0x004),
+	    pc_rd(pc_bdistm, 0x008), pc_rd(pc_bdistm, 0x00c));
+}
+
+/* C-2b-p upstream clock-offset probe.
+ *
+ * One register per pair of printfs on purpose: an MMIO read into an aperture
+ * that is powered off raises a Synchronous External abort (the failure mode
+ * that killed sweet_usb_probe() when it read the stale Sweet GCC offset). The
+ * offset and name are emitted before the read, so the persistent log keeps the
+ * last attempted address even if the read never returns. It runs after every
+ * C-2a line, which keeps the already verified C-2a evidence intact.
+ *
+ * Offsets come from drivers/clk/qcom/camcc-kaanapali.c and
+ * cambistmclkcc-kaanapali.c; CAMERA_C2B_CLOCK_INPUTS.md records the DT clock
+ * ID, rate and /proc/iomem cross-check. They remain candidates until this
+ * probe succeeds here. No register is written and no clock is voted. */
+static void
+pc_clock_probe(void)
+{
+	static const struct pc_reg {
+		uint32_t off;
+		const char *name;
+	} camcc_regs[] = {
+		{ 0x21250, "cci0_src_cmd_rcgr" },
+		{ 0x21268, "cci0_cbcr" },
+		{ 0x2126c, "cci1_src_cmd_rcgr" },
+		{ 0x21284, "cci1_cbcr" },
+		{ 0x21288, "cci2_src_cmd_rcgr" },
+		{ 0x212a0, "cci2_cbcr" },
+		{ 0x21334, "titan_top_gdscr" },
+		{ 0x21348, "core_ahb_cbcr" },
+		{ 0x21364, "gdsc_clk_cbcr" },
+		{ 0x21368, "sleep_clk_cbcr" },
+		{ 0x2137c, "cam_top_ahb_cbcr" },
+		{ 0x21390, "drv_xo_cbcr" },
+		{ 0x21398, "drv_ahb_cbcr" },
+	}, bdistm_regs[] = {
+		{ 0x4000, "mclk0_src_cmd_rcgr" },
+		{ 0x4018, "mclk0_cbcr" },
+		{ 0x4038, "mclk2_src_cmd_rcgr" },
+		{ 0x4050, "mclk2_cbcr" },
+		{ 0x4054, "mclk3_src_cmd_rcgr" },
+		{ 0x406c, "mclk3_cbcr" },
+		{ 0x4070, "mclk4_src_cmd_rcgr" },
+		{ 0x4088, "mclk4_cbcr" },
+		{ 0x40e0, "sleep_clk_cbcr" },
+	};
+
+	printf("PANDORA CAMERA: C-2b-p upstream clock probe (read-only, no vote)\n");
+	pc_step("CAMCC upstream clock offsets", PC_CAMCC_PA + 0x21250u);
+	for (unsigned i = 0; i < sizeof(camcc_regs) / sizeof(camcc_regs[0]); i++) {
+		printf("PANDORA CAMERA: CAMCC +%#x %s = ", camcc_regs[i].off, camcc_regs[i].name);
+		printf("%#x\n", pc_rd(pc_camcc, camcc_regs[i].off));
+	}
+	pc_step("BDISTM upstream clock offsets", PC_BDISTM_PA + 0x4000u);
+	for (unsigned i = 0; i < sizeof(bdistm_regs) / sizeof(bdistm_regs[0]); i++) {
+		printf("PANDORA CAMERA: BDISTM +%#x %s = ", bdistm_regs[i].off, bdistm_regs[i].name);
+		printf("%#x\n", pc_rd(pc_bdistm, bdistm_regs[i].off));
+	}
+	printf("PANDORA CAMERA: C-2b-p clock probe done (read-only)\n");
+}
+
+/* Emit the register name and offset BEFORE the read, one register per line,
+ * so a Synchronous External abort still leaves the last attempted offset in
+ * the persistent log. Used by both read-only snapshots (w0 before the write,
+ * w1 while the domain is up). No write is issued here. */
+static void
+pc_dump_reg(const char *phase, const char *what, vm_offset_t b, uint32_t off)
+{
+	printf("PANDORA CAMERA: %s %s +%#x = ", phase, what, off);
+	printf("%#x\n", pc_rd(b, off));
+}
+
+static void
+pc_w0_dump(void)
+{
+	printf("PANDORA CAMERA: C-2b-w0 status snapshot (read-only, before any write)\n");
+	pc_dump_reg("w0", "CAMCC cfg_gdscr", pc_camcc, PC_CFG_GDSCR);
+	if (!pc_cci[0]) {
+		printf("PANDORA CAMERA: C-2b-w0 CCI0 unmapped, CCI status skipped\n");
+	} else {
+		pc_dump_reg("w0", "CCI0 hw_version", pc_cci[0], PC_CCI_HW_VERSION);
+		pc_dump_reg("w0", "CCI0 irq_mask_0", pc_cci[0], PC_CCI_IRQ_MASK_0);
+		pc_dump_reg("w0", "CCI0 irq_status_0", pc_cci[0], PC_CCI_IRQ_STATUS_0);
+		pc_dump_reg("w0", "CCI0 m0q0 cur_word_cnt", pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(0, 0));
+		pc_dump_reg("w0", "CCI0 m0q1 cur_word_cnt", pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(0, 1));
+		pc_dump_reg("w0", "CCI0 m0 read_buf_level", pc_cci[0], PC_CCI_READ_BUF_LEVEL(0));
+		pc_dump_reg("w0", "CCI0 m0 scl_ctl", pc_cci[0], 0x100u);
+	}
+	printf("PANDORA CAMERA: C-2b-w0 snapshot done (read-only)\n");
+}
+
+/* C-2b-w1: re-read CCI0 status while its parent GDSC is up but the CCI branch
+ * and RCG are still off. w0's zeros came from an unpowered domain; this tells
+ * the next stage whether the controller becomes readable with the domain alone
+ * or needs its own branch clock too. Read-only. */
+static void
+pc_w1_cci_snapshot(void)
+{
+	if (!pc_cci[0]) {
+		printf("PANDORA CAMERA: w1 CCI0 after-domain snapshot skipped (unmapped)\n");
+		return;
+	}
+	printf("PANDORA CAMERA: w1 CCI0 after-domain status (read-only; CCI branch/RCG still off)\n");
+	pc_dump_reg("w1", "CCI0 hw_version", pc_cci[0], PC_CCI_HW_VERSION);
+	pc_dump_reg("w1", "CCI0 irq_mask_0", pc_cci[0], PC_CCI_IRQ_MASK_0);
+	pc_dump_reg("w1", "CCI0 irq_status_0", pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	pc_dump_reg("w1", "CCI0 m0q0 cur_word_cnt", pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(0, 0));
+	pc_dump_reg("w1", "CCI0 m0 scl_ctl", pc_cci[0], 0x100u);
+	printf("PANDORA CAMERA: w1 CCI0 after-domain snapshot done (read-only)\n");
+}
+
+static int
+pc_wait_gdsc_up(void)
+{
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		uint32_t cfg = pc_rd(pc_camcc, PC_CFG_GDSCR);
+		printf("PANDORA CAMERA: w1 gdsc poll %u cfg_gdscr=%#x\n", i, cfg);
+		if (cfg & PC_CFG_GDSC_PWR_UP) {
+			return 0;
+		}
+		pc_sleep(1);
+	}
+	return ETIMEDOUT;
+}
+
+/* Upstream gdsc_disable() -> gdsc_toggle_logic() -> gdsc_poll_status() polls
+ * CFG_GDSCR POWER_DOWN_COMPLETE (bit 15) for a POLL_CFG_GDSCR domain. One
+ * read is not proof the domain returned to OFF. */
+static int
+pc_wait_gdsc_down(void)
+{
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		uint32_t cfg = pc_rd(pc_camcc, PC_CFG_GDSCR);
+		printf("PANDORA CAMERA: w1 gdsc-down poll %u cfg_gdscr=%#x\n", i, cfg);
+		if (cfg & PC_CFG_GDSC_PWR_DOWN) {
+			return 0;
+		}
+		pc_sleep(1);
+	}
+	return ETIMEDOUT;
+}
+
+static int
+pc_wait_branch_on(const char *phase, uint32_t off)
+{
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		uint32_t v = pc_rd(pc_camcc, off);
+		printf("PANDORA CAMERA: %s branch +%#x poll %u cbcr=%#x\n", phase, off, i, v);
+		if (!(v & PC_CBCR_CLK_OFF)) {
+			return 0;
+		}
+		pc_sleep(1);
+	}
+	return ETIMEDOUT;
+}
+
+/* C-2b-w2, part 1: read-only. Expose the CCI0 RCG state while the parent GDSC
+ * is up. C-2b-p read CMD_RCGR = 0x80000000 with the domain off; this says
+ * whether the root is still parked and is the input for a later PLL/RCG
+ * bring-up. No RCG, PLL or CBCR is written here. */
+static void
+pc_w2_dump(void)
+{
+	printf("PANDORA CAMERA: C-2b-w2 RCG snapshot (read-only; no RCG/PLL write)\n");
+	pc_dump_reg("w2", "CCI0 cmd_rcgr", pc_camcc, PC_CCI0_CMD_RCGR);
+	pc_dump_reg("w2", "CCI0 cfg_rcgr", pc_camcc, PC_CCI0_CFG_RCGR);
+	pc_dump_reg("w2", "CCI0 m", pc_camcc, PC_CCI0_M_REG);
+	pc_dump_reg("w2", "CCI0 n", pc_camcc, PC_CCI0_N_REG);
+	pc_dump_reg("w2", "CCI0 d", pc_camcc, PC_CCI0_D_REG);
+	pc_dump_reg("w2", "CCI0 cbcr", pc_camcc, PC_CCI0_CBCR);
+	printf("PANDORA CAMERA: w2 cmd_root_off=%s\n",
+	    (pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_ROOT_OFF) ? "yes" : "no");
+}
+
+/* C-2b-w3: read-only controller status while the CCI0 branch is on. This
+ * answers whether the CCI block itself becomes live (timing / queue / IRQ)
+ * once the branch runs, or whether those registers still need explicit setup.
+ * No queue word, IRQ mask or timing register is written. */
+static void
+pc_w3_controller(const char *phase)
+{
+	if (!pc_cci[0]) {
+		printf("PANDORA CAMERA: %s CCI0 controller snapshot skipped (unmapped)\n", phase);
+		return;
+	}
+	printf("PANDORA CAMERA: %s CCI0 controller status (read-only)\n", phase);
+	pc_dump_reg(phase, "CCI0 hw_version", pc_cci[0], PC_CCI_HW_VERSION);
+	pc_dump_reg(phase, "CCI0 irq_mask_0", pc_cci[0], PC_CCI_IRQ_MASK_0);
+	pc_dump_reg(phase, "CCI0 irq_status_0", pc_cci[0], PC_CCI_IRQ_STATUS_0);
+	pc_dump_reg(phase, "CCI0 m0q0 cur_word_cnt", pc_cci[0], PC_CCI_Qn_CUR_WORD_CNT(0, 0));
+	pc_dump_reg(phase, "CCI0 m0 read_buf_level", pc_cci[0], PC_CCI_READ_BUF_LEVEL(0));
+	pc_dump_reg(phase, "CCI0 m0 scl_ctl", pc_cci[0], PC_CCI_SCL_CTL(0));
+	pc_dump_reg(phase, "CCI0 m0 sda_ctl_0", pc_cci[0], PC_CCI_SDA_CTL_0(0));
+}
+
+/* C-2b-w4: read-only TAYCAN_ELU PLL0 + CCI0 RCG state snapshot. This is the
+ * device-side read of PLL0's runtime state that §6 of
+ * CAMERA_C2B_RCG_CCI_INPUTS.md lists as still open. The authoritative
+ * clk_taycan_elu_pll_configure() body is NOT in torvalds/linux (only the enum
+ * /regs table / dispatch case are), and the PLL bit masks live in clk-regmap.h
+ * which is not cached, so this probe does NOT write any PLL register — it only
+ * reads and prints the raw values alongside the known config values for
+ * comparison. Decoding the MODE/STATE/STATUS bits is best-effort until those
+ * masks are located; the raw hex is the deliverable. No clock is voted. */
+static void
+pc_w4_pll_snapshot(void)
+{
+	uint32_t mode, opmcde, state, status, lval, alpha, uctl, uctu;
+	uint32_t cfg, cfgu, cfgu1, tctl, tctu;
+
+	if (!pc_camcc) {
+		printf("PANDORA CAMERA: w4 PLL0 snapshot skipped (camcc unmapped)\n");
+		return;
+	}
+	mode   = pc_rd(pc_camcc, PC_PLL0_MODE);
+	opmcde = pc_rd(pc_camcc, PC_PLL0_OPMCDE);
+	state  = pc_rd(pc_camcc, PC_PLL0_STATE);
+	status = pc_rd(pc_camcc, PC_PLL0_STATUS);
+	lval   = pc_rd(pc_camcc, PC_PLL0_L_VAL);
+	alpha  = pc_rd(pc_camcc, PC_PLL0_ALPHA);
+	uctl   = pc_rd(pc_camcc, PC_PLL0_USER_CTL);
+	uctu   = pc_rd(pc_camcc, PC_PLL0_USER_CTL_U);
+	cfg    = pc_rd(pc_camcc, PC_PLL0_CONFIG_CTL);
+	cfgu   = pc_rd(pc_camcc, PC_PLL0_CONFIG_CTL_U);
+	cfgu1  = pc_rd(pc_camcc, PC_PLL0_CONFIG_CTL_U1);
+	tctl   = pc_rd(pc_camcc, PC_PLL0_TEST_CTL);
+	tctu   = pc_rd(pc_camcc, PC_PLL0_TEST_CTL_U);
+	printf("PANDORA CAMERA: C-2b-w4 PLL0 (TAYCAN_ELU, camcc+0x0) read-only snapshot\n");
+	printf("PANDORA CAMERA: w4 PLL0 mode     +0x000=%#x  opmcde +0x004=%#x  state +0x008=%#x  status +0x00c=%#x\n",
+	    mode, opmcde, state, status);
+	printf("PANDORA CAMERA: w4 PLL0 l_val    +0x010=%#x (config l=%#x)  alpha +0x014=%#x (config alpha=%#x)\n",
+	    lval, 0x3eu, alpha, 0x8000u);
+	printf("PANDORA CAMERA: w4 PLL0 user_ctl +0x018=%#x (config %#x)  user_ctu +0x01c=%#x (config %#x)\n",
+	    uctl, 0x00008408u, uctu, 0x00000002u);
+	printf("PANDORA CAMERA: w4 PLL0 cfg_ctl  +0x020=%#x (config %#x)  cfg_ctu +0x024=%#x (config %#x)  cfg_ctu1 +0x028=%#x (config %#x)\n",
+	    cfg, 0x25c400e7u, cfgu, 0x0a8062e0u, cfgu1, 0xf51dea20u);
+	printf("PANDORA CAMERA: w4 PLL0 test_ctl +0x02c=%#x  test_ctu +0x030=%#x\n", tctl, tctu);
+	printf("PANDORA CAMERA: w4 CCI0 cmd_rcgr +0x21250=%#x cfg_rcgr +0x21254=%#x m +0x21258=%#x n +0x2125c=%#x d +0x21260=%#x cbcr +0x21268=%#x\n",
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR), pc_rd(pc_camcc, PC_CCI0_CFG_RCGR),
+	    pc_rd(pc_camcc, PC_CCI0_M_REG), pc_rd(pc_camcc, PC_CCI0_N_REG),
+	    pc_rd(pc_camcc, PC_CCI0_D_REG), pc_rd(pc_camcc, PC_CCI0_CBCR));
+}
+
+/* C-2b-w2/w3: write ONLY the CCI0 branch CBCR BIT(0) and bounded-poll
+ * CLK_OFF. Capture the full CMD_RCGR / CFG_RCGR before and after so the
+ * hardware's ROOT_OFF behaviour is visible, and read the controller state
+ * while the branch is on. The caller restores the exact pre-write CBCR and
+ * checks that the RCG root re-parked. Returns true only if CLK_OFF cleared. */
+static bool
+pc_w2_branch(uint32_t *before, uint32_t *cmd_before, uint32_t *cfg_before)
+{
+	uint32_t v = pc_rd(pc_camcc, PC_CCI0_CBCR);
+	uint32_t cmd_after, cfg_after;
+	int ret;
+
+	*before = v;
+	*cmd_before = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	*cfg_before = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w2 CCI0 branch before=%#x cmd_rcgr=%#x cfg_rcgr=%#x "
+	    "(BIT(0) only; RCG/PLL untouched)\n", v, *cmd_before, *cfg_before);
+	pc_step("w2 CCI0 branch", PC_CAMCC_PA + PC_CCI0_CBCR);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, v | PC_CBCR_ENABLE);
+	ret = pc_wait_branch_on("w2", PC_CCI0_CBCR);
+	cmd_after = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_after = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w2 CCI0 branch after=%#x poll_ret=%d cmd_rcgr=%#x "
+	    "cfg_rcgr=%#x root_off=%s\n",
+	    pc_rd(pc_camcc, PC_CCI0_CBCR), ret, cmd_after, cfg_after,
+	    (cmd_after & PC_CMD_ROOT_OFF) ? "yes" : "no");
+	pc_w3_controller("w3-branch-on");
+	return ret == 0;
+}
+
+/* C-2b-w5: switch the CCI0 RCG source from XO (SRC_SEL=0) to
+ * PLL0_OUT_EVEN/16 (37.5 MHz) using the cached clk_rcg2_shared_set_rate
+ * handshake, then roll it back. Runs while the parent TITAN_TOP GDSC and the
+ * AHB branches are already up (called from pc_w1_bringup after w2).
+ *
+ * Sequence (cached clk-rcg2.c update_config / clk_rcg2_configure):
+ *   1. snapshot CMD_RCGR/CFG_RCGR/CBCR before.
+ *   2. force-enable root + branch on: write CCI0 CBCR BIT(0), poll CLK_OFF
+ *      clear. HW_CLK_CTRL un-parks the root (CMD_ROOT_OFF clears) -- proven in
+ *      w2/w3, so this IS the force-enable; no separate CMD_ROOT_EN write.
+ *   3. write CFG_RCGR with SRC_SEL=2 (PLL0_OUT_EVEN), SRC_DIV=16, keep
+ *      HW_CLK_CTRL, MODE=0.
+ *   4. commit: write CMD_RCGR CMD_UPDATE, poll CMD_UPDATE until it clears.
+ *   5. read back CFG_RCGR/CMD_RCGR/CBCR; report whether SRC_SEL switched.
+ *   6. roll back in reverse: restore CFG, CMD_UPDATE+poll, then branch off
+ *      (root re-parks, as w3 proved), verify CMD_RCGR+CFG_RCGR restored.
+ * No PLL register, RCG M/N, rail, GPIO or CCI queue word is touched. Every
+ * failure is printed and still rolls back; a missing status bit is never
+ * turned into success. */
+static void __unused
+pc_w5_rcg_switch(void)
+{
+	uint32_t cbcr_before, cmd_before, cfg_before;
+	uint32_t cfg_new, cmd_after, cfg_after, cbcr_after;
+	uint32_t cmd_restored, cfg_restored;
+	int upd_ret = 0, rb_upd_ret = 0;
+	bool switched = false, root_reparked = false, restored_clean = false;
+
+	if (!pc_camcc) {
+		printf("PANDORA CAMERA: C-2b-w5 skipped (camcc unmapped)\n");
+		return;
+	}
+	cbcr_before = pc_rd(pc_camcc, PC_CCI0_CBCR);
+	cmd_before  = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_before  = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w5 RCG switch before: cbcr=%#x cmd_rcgr=%#x "
+	    "cfg_rcgr=%#x root_off=%s src_sel=%u src_div=%u hw_clk_ctrl=%s\n",
+	    cbcr_before, cmd_before, cfg_before,
+	    (cmd_before & PC_CMD_ROOT_OFF) ? "yes" : "no",
+	    (unsigned)((cfg_before & PC_CFG_SRC_SEL_MASK) >> PC_CFG_SRC_SEL_SHIFT),
+	    (unsigned)(cfg_before & PC_CFG_SRC_DIV_MASK),
+	    (cfg_before & PC_CFG_HW_CLK_CTRL) ? "yes" : "no");
+
+	/* 2. branch on (running clock to observe), then FORCE-ENABLE root via
+	 *    CMD_ROOT_EN. HW_CLK_CTRL branch-on alone un-parks the root (clock
+	 *    runs) but does NOT make CMD_UPDATE latch -- the RCG needs CMD_ROOT_EN
+	 *    set, exactly like Linux clk_rcg2_shared_set_rate's clk_rcg2_set_force_enable.
+	 *    Without it CMD_UPDATE times out and the new source is never applied. */
+	pc_step("w5 CCI0 branch", PC_CAMCC_PA + PC_CCI0_CBCR);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before | PC_CBCR_ENABLE);
+	if (pc_wait_branch_on("w5", PC_CCI0_CBCR) != 0) {
+		printf("PANDORA CAMERA: C-2b-w5 branch did NOT come up; aborting "
+		    "switch (no CFG write issued)\n");
+		pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+		return;
+	}
+	pc_step("w5 force-enable root", PC_CAMCC_PA + PC_CCI0_CMD_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_ROOT_EN);
+	bool root_on = false;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_ROOT_OFF)) {
+			root_on = true;
+			break;
+		}
+		pc_sleep(1);
+	}
+	printf("PANDORA CAMERA: C-2b-w5 root force-enabled=%s cmd_rcgr=%#x\n",
+	    root_on ? "yes" : "NO", pc_rd(pc_camcc, PC_CCI0_CMD_RCGR));
+
+	/* 3. compute new CFG_RCGR: SRC_SEL=2, SRC_DIV=16, keep HW_CLK_CTRL, MODE=0. */
+	cfg_new = (cfg_before &
+	    ~(PC_CFG_SRC_SEL_MASK | PC_CFG_SRC_DIV_MASK | PC_CFG_MODE_MASK |
+	      PC_CFG_HW_CLK_CTRL)) |
+	    (2u << PC_CFG_SRC_SEL_SHIFT) | (16u << 0) | PC_CFG_HW_CLK_CTRL;
+	printf("PANDORA CAMERA: C-2b-w5 writing cfg_rcgr=%#x (SRC_SEL=2 PLL0_OUT_EVEN, "
+	    "SRC_DIV=16, HW_CLK_CTRL kept, MODE=0)\n", cfg_new);
+	pc_step("w5 CFG_RCGR", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_new);
+
+	/* 4. commit: CMD_UPDATE + poll CMD_UPDATE clear (update_config). */
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+		upd_ret = ETIMEDOUT;
+	}
+	printf("PANDORA CAMERA: C-2b-w5 update_config ret=%d\n", upd_ret);
+
+	/* 5. read back after. SWITCHED requires BOTH the new SRC_SEL in CFG_RCGR AND
+	 *    the hardware having ACKed CMD_UPDATE (cmd_update_clear). A register write
+	 *    alone is NOT proof -- if CMD_UPDATE is still set the RCG never latched
+	 *    the new source. */
+	cmd_after  = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_after  = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	cbcr_after = pc_rd(pc_camcc, PC_CCI0_CBCR);
+	bool update_acked = !(cmd_after & PC_CMD_UPDATE);
+	switched = (((cfg_after & PC_CFG_SRC_SEL_MASK) >> PC_CFG_SRC_SEL_SHIFT) == 2u)
+	    && update_acked;
+	printf("PANDORA CAMERA: C-2b-w5 after: cbcr=%#x cmd_rcgr=%#x cfg_rcgr=%#x "
+	    "src_sel=%u src_div=%u clk_off=%s update_acked=%s -> %s\n",
+	    cbcr_after, cmd_after, cfg_after,
+	    (unsigned)((cfg_after & PC_CFG_SRC_SEL_MASK) >> PC_CFG_SRC_SEL_SHIFT),
+	    (unsigned)(cfg_after & PC_CFG_SRC_DIV_MASK),
+	    (cbcr_after & PC_CBCR_CLK_OFF) ? "yes" : "no",
+	    update_acked ? "yes" : "no",
+	    switched ? "SWITCHED" : "NOT SWITCHED");
+	pc_w3_controller("w5-switched");
+
+	/* 6. roll back in reverse: restore CFG, CMD_UPDATE+poll, CLEAR force-enable,
+	 *    branch off -> HW_CLK_CTRL re-parks the root. */
+	pc_step("w5 rollback", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_before);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			rb_upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+		rb_upd_ret = ETIMEDOUT;
+	}
+	/* clear force-enable (CMD_ROOT_EN), then branch off. Without clearing
+	 * CMD_ROOT_EN the root would stay force-enabled after the probe. */
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & ~PC_CMD_ROOT_EN);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+	cmd_restored = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_restored = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	root_reparked = (cmd_restored & PC_CMD_ROOT_OFF) != 0;
+	restored_clean = (cmd_restored == cmd_before) &&
+	    (cfg_restored == cfg_before);
+	printf("PANDORA CAMERA: C-2b-w5 cleanup: cmd_rcgr=%#x (before=%#x) "
+	    "cfg_rcgr=%#x (before=%#x) root_reparked=%s rb_update=%d -> %s\n",
+	    cmd_restored, cmd_before, cfg_restored, cfg_before,
+	    root_reparked ? "yes" : "no", rb_upd_ret,
+	    restored_clean ? "CLEAN" : "LEFTOVER (probe changed CCI0 RCG state)");
+	if (switched) {
+		printf("PANDORA CAMERA: C-2b-w5 result: branch_up=yes source_switched=yes "
+		    "rollback=%s -> %s\n", restored_clean ? "CLEAN" : "LEFTOVER",
+		    restored_clean ? "PASS (runtime proof PLL0 usable w/o sw enable)"
+		                   : "PARTIAL (switch ok, rollback incomplete)");
+	} else {
+		printf("PANDORA CAMERA: C-2b-w5 result: source NOT switched; "
+		    "update_acked=%s rollback=%s\n",
+		    update_acked ? "yes" : "no", restored_clean ? "CLEAN" : "LEFTOVER");
+	}
+}
+
+/* C-2b-w6: diagnose the CMD_UPDATE non-ack seen in w5 (update_config ret=60,
+ * ETIMEDOUT). Four hypotheses, one boot, CCI0 RCG registers only -- no PLL,
+ * no RCG M/N/D, no rail/GPIO/CCI transaction:
+ *
+ *   Phase A: reproduce w5 exactly (branch-on + CMD_ROOT_EN force-enable +
+ *            write CFG_RCGR SRC_SEL=2/SRC_DIV=16/HW_CLK_CTRL + CMD_UPDATE).
+ *   Phase B (H2): if CMD_UPDATE is stuck, write 0 explicitly to clear it.
+ *            Does the bit clear, or is it frozen hardware state?
+ *   Phase C (H5): CMD_UPDATE again with CFG_HW_CLK_CTRL cleared. Is the
+ *            update refused *because* bit 20 is set?
+ *   Phase D (H1/H4): restore HW_CLK_CTRL CFG, then branch off->on. Does the
+ *            mux reload without CMD_UPDATE? Then retry CMD_UPDATE once more
+ *            (maybe the reload unblocks it).
+ *   Phase E (H3): read-only PLL0 dump (USER_CTL/USER_CTL_U/STATE/STATUS) --
+ *            is PLL0_OUT_EVEN output gated even though the PLL is running?
+ *   Phase F: rollback. Restore CFG, CMD_UPDATE + poll, explicit 0-clear if
+ *            frozen, clear CMD_ROOT_EN, branch off -> HW_CLK_CTRL re-parks
+ *            the root. CLEAN = ROOT_OFF set + CMD_UPDATE/CMD_ROOT_EN clear +
+ *            CFG restored (this is the state w3 checks as 0x80000000).
+ */
+static void
+pc_w6_update_diag(void)
+{
+	uint32_t cbcr_before, cmd_before, cfg_before;
+	uint32_t cfg_new, v;
+	bool update_acked = false;
+	bool h2_clear_worked = false;
+	bool h5_acked = false;
+	bool h1_clock_ran = false;
+	bool h1d2_acked = false;
+	int upd_ret;
+
+	if (!pc_camcc) {
+		printf("PANDORA CAMERA: C-2b-w6 skipped (camcc unmapped)\n");
+		return;
+	}
+	cbcr_before = pc_rd(pc_camcc, PC_CCI0_CBCR);
+	cmd_before  = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_before  = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+	printf("PANDORA CAMERA: C-2b-w6 diag before: cbcr=%#x cmd_rcgr=%#x "
+	    "cfg_rcgr=%#x root_off=%s src_sel=%u src_div=%u hw_clk_ctrl=%s\n",
+	    cbcr_before, cmd_before, cfg_before,
+	    (cmd_before & PC_CMD_ROOT_OFF) ? "yes" : "no",
+	    (unsigned)((cfg_before & PC_CFG_SRC_SEL_MASK) >> PC_CFG_SRC_SEL_SHIFT),
+	    (unsigned)(cfg_before & PC_CFG_SRC_DIV_MASK),
+	    (cfg_before & PC_CFG_HW_CLK_CTRL) ? "yes" : "no");
+
+	cfg_new = (cfg_before &
+	    ~(PC_CFG_SRC_SEL_MASK | PC_CFG_SRC_DIV_MASK | PC_CFG_MODE_MASK |
+	      PC_CFG_HW_CLK_CTRL)) |
+	    (2u << PC_CFG_SRC_SEL_SHIFT) | (16u << 0) | PC_CFG_HW_CLK_CTRL;
+
+	/* Phase A: reproduce w5. */
+	pc_step("w6 branch on", PC_CAMCC_PA + PC_CCI0_CBCR);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before | PC_CBCR_ENABLE);
+	if (pc_wait_branch_on("w6", PC_CCI0_CBCR) != 0) {
+		printf("PANDORA CAMERA: C-2b-w6 branch did NOT come up; abort "
+		    "(no CFG write issued)\n");
+		pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+		return;
+	}
+	pc_step("w6 force-enable root", PC_CAMCC_PA + PC_CCI0_CMD_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_ROOT_EN);
+	printf("PANDORA CAMERA: C-2b-w6 A force-enable cmd_rcgr=%#x\n",
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR));
+	pc_step("w6 A CFG write", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_new);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	upd_ret = ETIMEDOUT;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+	}
+	v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	update_acked = !(v & PC_CMD_UPDATE);
+	printf("PANDORA CAMERA: C-2b-w6 A reproduce: update_config ret=%d "
+	    "cmd_rcgr=%#x cfg_rcgr=%#x update_acked=%s\n", upd_ret, v,
+	    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR), update_acked ? "yes" : "no");
+
+	/* Phase B (H2): explicit 0-write to clear a stuck CMD_UPDATE. */
+	if (!update_acked) {
+		pc_step("w6 B H2 explicit clear", PC_CAMCC_PA + PC_CCI0_CMD_RCGR);
+		pc_wr(pc_camcc, PC_CCI0_CMD_RCGR, v & ~PC_CMD_UPDATE);
+		v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+		h2_clear_worked = !(v & PC_CMD_UPDATE);
+		printf("PANDORA CAMERA: C-2b-w6 B H2 explicit CMD_UPDATE clear: "
+		    "cmd_rcgr=%#x h2_clear_worked=%s\n", v,
+		    h2_clear_worked ? "yes" : "no");
+	}
+
+	/* Phase C (H5): CMD_UPDATE with HW_CLK_CTRL cleared in CFG. */
+	pc_step("w6 C H5 cfg w/o HW_CLK_CTRL", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_new & ~PC_CFG_HW_CLK_CTRL);
+	printf("PANDORA CAMERA: C-2b-w6 C H5 writing cfg_rcgr=%#x "
+	    "(HW_CLK_CTRL cleared)\n", cfg_new & ~PC_CFG_HW_CLK_CTRL);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	upd_ret = ETIMEDOUT;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+	}
+	v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	h5_acked = !(v & PC_CMD_UPDATE);
+	printf("PANDORA CAMERA: C-2b-w6 C H5 update w/o HW_CLK_CTRL: ret=%d "
+	    "cmd_rcgr=%#x cfg_rcgr=%#x h5_acked=%s\n", upd_ret, v,
+	    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR), h5_acked ? "yes" : "no");
+	if (!h5_acked) {
+		pc_wr(pc_camcc, PC_CCI0_CMD_RCGR, v & ~PC_CMD_UPDATE);
+		printf("PANDORA CAMERA: C-2b-w6 C H5 explicit clear -> %#x\n",
+		    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR));
+	}
+
+	/* Phase D (H1/H4): branch off->on with HW_CLK_CTRL CFG restored. */
+	pc_step("w6 D H1 cfg restore", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_new);
+	printf("PANDORA CAMERA: C-2b-w6 D H1/H4 branch off->on with cfg=%#x\n",
+	    cfg_new);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);                 /* off */
+	pc_sleep(1);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before | PC_CBCR_ENABLE); /* on */
+	h1_clock_ran = (pc_wait_branch_on("w6-h1", PC_CCI0_CBCR) == 0);
+	printf("PANDORA CAMERA: C-2b-w6 D H1/H4 branch_reload: clock_running=%s "
+	    "cmd_rcgr=%#x cfg_rcgr=%#x cbcr=%#x\n",
+	    h1_clock_ran ? "yes" : "no", pc_rd(pc_camcc, PC_CCI0_CMD_RCGR),
+	    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR), pc_rd(pc_camcc, PC_CCI0_CBCR));
+	/* D2: retry CMD_UPDATE once after the reload. */
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	upd_ret = ETIMEDOUT;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+	}
+	v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	h1d2_acked = !(v & PC_CMD_UPDATE);
+	printf("PANDORA CAMERA: C-2b-w6 D2 CMD_UPDATE after reload: ret=%d "
+	    "cmd_rcgr=%#x h1d2_acked=%s\n", upd_ret, v,
+	    h1d2_acked ? "yes" : "no");
+	if (!h1d2_acked) {
+		pc_wr(pc_camcc, PC_CCI0_CMD_RCGR, v & ~PC_CMD_UPDATE);
+	}
+
+	/* Phase E (H3): read-only PLL0 output-enable dump. */
+	printf("PANDORA CAMERA: C-2b-w6 E H3 PLL0 dump (read-only): mode=%#x "
+	    "state=%#x status=%#x l_val=%#x user_ctl=%#x user_ctl_u=%#x\n",
+	    pc_rd(pc_camcc, PC_PLL0_MODE), pc_rd(pc_camcc, PC_PLL0_STATE),
+	    pc_rd(pc_camcc, PC_PLL0_STATUS), pc_rd(pc_camcc, PC_PLL0_L_VAL),
+	    pc_rd(pc_camcc, PC_PLL0_USER_CTL),
+	    pc_rd(pc_camcc, PC_PLL0_USER_CTL_U));
+	pc_w3_controller("w6-diag");
+
+	/* Phase F: rollback to the idle parked state (w3's 0x80000000). */
+	pc_step("w6 rollback", PC_CAMCC_PA + PC_CCI0_CFG_RCGR);
+	pc_wr(pc_camcc, PC_CCI0_CFG_RCGR, cfg_before);
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) | PC_CMD_UPDATE);
+	upd_ret = ETIMEDOUT;
+	for (unsigned i = 0; i < PC_POLL_STEPS; i++) {
+		if (!(pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_UPDATE)) {
+			upd_ret = 0;
+			break;
+		}
+		pc_sleep(1);
+	}
+	v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	if (v & PC_CMD_UPDATE) {
+		pc_wr(pc_camcc, PC_CCI0_CMD_RCGR, v & ~PC_CMD_UPDATE);
+		printf("PANDORA CAMERA: C-2b-w6 rollback: CMD_UPDATE frozen, "
+		    "explicit clear -> %#x\n", pc_rd(pc_camcc, PC_CCI0_CMD_RCGR));
+	}
+	pc_wr(pc_camcc, PC_CCI0_CMD_RCGR,
+	    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & ~PC_CMD_ROOT_EN);
+	pc_wr(pc_camcc, PC_CCI0_CBCR, cbcr_before);
+	v = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+	cfg_new = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);   /* reuse as cfg_restored */
+	{
+		bool root_reparked = (v & PC_CMD_ROOT_OFF) != 0;
+		bool cmd_clear = !(v & (PC_CMD_UPDATE | PC_CMD_ROOT_EN));
+		bool clean = root_reparked && cmd_clear && (cfg_new == cfg_before);
+		printf("PANDORA CAMERA: C-2b-w6 cleanup: cmd_rcgr=%#x (entry=%#x) "
+		    "cfg_rcgr=%#x (entry=%#x) root_reparked=%s cmd_bits_clear=%s "
+		    "rb_update=%d -> %s\n",
+		    v, cmd_before, cfg_new, cfg_before,
+		    root_reparked ? "yes" : "no", cmd_clear ? "yes" : "no",
+		    upd_ret, clean ? "CLEAN" : "LEFTOVER (probe changed CCI0 RCG state)");
+		printf("PANDORA CAMERA: C-2b-w6 result: A_update_acked=%s "
+		    "B_h2_explicit_clear=%s C_h5_acked_no_hwctl=%s "
+		    "D_branch_reload_clock=%s D2_update_after_reload=%s "
+		    "rollback=%s\n",
+		    update_acked ? "yes" : "no",
+		    h2_clear_worked ? "yes" : "no",
+		    h5_acked ? "yes" : "no",
+		    h1_clock_ran ? "yes" : "no",
+		    h1d2_acked ? "yes" : "no",
+		    clean ? "CLEAN" : "LEFTOVER");
+	}
+}
+static void
+pc_w1_bringup(void)
+{
+	static const uint32_t critical[] = { 0x21398u, 0x21390u, 0x21364u, 0x21368u };
+	uint32_t gdscr0, core0, top0, cfg, gdscr_now;
+	uint32_t cci0_0 = 0;
+	uint32_t cmd0 = 0, cfg0 = 0, cmd_restored = 0, cfg_restored = 0;
+	int ret = 0, down_ret;
+	bool gdsc_up = false, branch_up = false, restored, power_down_ok = false;
+	bool core_ahb_stuck = false;
+	bool w2_up = false, w2_ran = false, root_reparked = false, w2_clean = true;
+
+	printf("PANDORA CAMERA: C-2b-w1 bring-up starts (GDSC + 2 AHB branches; "
+	    "no rail vote, no RCG, no CCI, no GPIO)\n");
+
+	/* Precondition: the critical CBCRs were enabled at boot (C-2b-p read
+	 * 0x08000001 on all four). If they are not, write nothing at all. */
+	for (unsigned i = 0; i < sizeof(critical) / sizeof(critical[0]); i++) {
+		cfg = pc_rd(pc_camcc, critical[i]);
+		printf("PANDORA CAMERA: w1 critical +%#x = %#x\n", critical[i], cfg);
+		if (!(cfg & PC_CBCR_ENABLE)) {
+			printf("PANDORA CAMERA: w1 ABORT: critical CBCR +%#x has no enable bit; no write issued\n",
+			    critical[i]);
+			return;
+		}
+	}
+
+	gdscr0 = pc_rd(pc_camcc, PC_GDSCR);
+	core0 = pc_rd(pc_camcc, PC_CORE_AHB_CBCR);
+	top0 = pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR);
+	printf("PANDORA CAMERA: w1 before: gdscr=%#x cfg_gdscr=%#x core_ahb=%#x cam_top_ahb=%#x\n",
+	    gdscr0, pc_rd(pc_camcc, PC_CFG_GDSCR), core0, top0);
+
+	/* 1. TITAN_TOP GDSC: clear SW_COLLAPSE, poll CFG_GDSCR bit 16. */
+	pc_step("w1 GDSC enable", PC_CAMCC_PA + PC_GDSCR);
+	pc_wr(pc_camcc, PC_GDSCR, gdscr0 & ~PC_GDSC_SW_COLLAPSE);
+	printf("PANDORA CAMERA: w1 wrote gdscr=%#x (SW_COLLAPSE cleared)\n",
+	    pc_rd(pc_camcc, PC_GDSCR));
+	ret = pc_wait_gdsc_up();
+	if (ret) {
+		printf("PANDORA CAMERA: w1 GDSC ERROR %d (power-up complete never observed)\n", ret);
+	} else {
+		gdsc_up = true;
+		pc_sleep(1);                 /* upstream udelay(1) after toggle */
+		pc_wr(pc_camcc, PC_GDSCR, pc_rd(pc_camcc, PC_GDSCR) | PC_GDSC_RETAIN_FF);
+		printf("PANDORA CAMERA: w1 GDSC up: gdscr=%#x cfg_gdscr=%#x\n",
+		    pc_rd(pc_camcc, PC_GDSCR), pc_rd(pc_camcc, PC_CFG_GDSCR));
+	}
+
+	/* 2. CORE_AHB: BRANCH_HALT_DELAY has no halt bit, just a delay. */
+	if (ret == 0) {
+		pc_step("w1 CORE_AHB", PC_CAMCC_PA + PC_CORE_AHB_CBCR);
+		pc_wr(pc_camcc, PC_CORE_AHB_CBCR, core0 | PC_CBCR_ENABLE);
+		pc_sleep(1);                 /* upstream udelay(10) */
+		cfg = pc_rd(pc_camcc, PC_CORE_AHB_CBCR);
+		/* camcc-kaanapali.c: cam_cc_core_ahb_clk is an ordinary
+		 * clk_branch2 with enable_mask BIT(0), not a critical or
+		 * hardware-voted clock. A missing readback bit is therefore an
+		 * unexplained observation, not a BRANCH_HALT_DELAY quirk. */
+		core_ahb_stuck = !(cfg & PC_CBCR_ENABLE);
+		printf("PANDORA CAMERA: w1 core_ahb now=%#x enable_stuck=%s "
+		    "(BRANCH_HALT_DELAY has no halt poll)\n",
+		    cfg, core_ahb_stuck ? "YES" : "no");
+
+		/* 3. CAM_TOP_AHB: BRANCH_HALT, poll CLK_OFF clearing. */
+		pc_step("w1 CAM_TOP_AHB", PC_CAMCC_PA + PC_CAM_TOP_AHB_CBCR);
+		pc_wr(pc_camcc, PC_CAM_TOP_AHB_CBCR, top0 | PC_CBCR_ENABLE);
+		ret = pc_wait_branch_on("w1", PC_CAM_TOP_AHB_CBCR);
+		if (ret) {
+			printf("PANDORA CAMERA: w1 CAM_TOP_AHB ERROR %d (CLK_OFF never cleared)\n", ret);
+		} else {
+			branch_up = true;
+		}
+	}
+
+	/* A/B snapshot while (if) the domain is up. CCI0's own branch and RCG
+	 * were deliberately left off, so a zero CCI timing register here is the
+	 * expected state, NOT a failure of w1. */
+	printf("PANDORA CAMERA: w1 A/B snapshot: gdscr=%#x cfg_gdscr=%#x core_ahb=%#x "
+	    "cam_top_ahb=%#x cci0_cbcr=%#x\n",
+	    pc_rd(pc_camcc, PC_GDSCR), pc_rd(pc_camcc, PC_CFG_GDSCR),
+	    pc_rd(pc_camcc, PC_CORE_AHB_CBCR), pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR),
+	    pc_rd(pc_camcc, 0x21268u));
+	if (pc_cci[0]) {
+		printf("PANDORA CAMERA: w1 CCI0 m0 scl_ctl=%#x (CCI branch/RCG untouched; "
+		    "zero is expected)\n", pc_rd(pc_cci[0], 0x100u));
+	}
+	pc_w1_cci_snapshot();
+
+	/* C-2b-w2 runs while the GDSC is still up. It reads the CCI0 RCG state
+	 * and writes only the CCI0 branch CBCR. The parent RCG is in ROOT_OFF
+	 * (C-2b-p), so "branch not on" is an expected possible outcome and is
+	 * reported as its own result; it never changes the w1 verdict. */
+	pc_w2_dump();
+	if (gdsc_up && branch_up) {
+		w2_ran = true;
+		w2_up = pc_w2_branch(&cci0_0, &cmd0, &cfg0);
+		printf("PANDORA CAMERA: C-2b-w2 result: branch_up=%s cmd_rcgr=%#x root_off=%s "
+		    "-> %s (exploratory; does not gate the w1 verdict)\n",
+		    w2_up ? "yes" : "no",
+		    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR),
+		    (pc_rd(pc_camcc, PC_CCI0_CMD_RCGR) & PC_CMD_ROOT_OFF) ? "yes" : "no",
+		    w2_up ? "BRANCH ON" : "BRANCH NOT ON");
+	} else {
+		printf("PANDORA CAMERA: C-2b-w2 skipped (GDSC or CAM_TOP_AHB not up)\n");
+	}
+
+	/* C-2b-w5 runs while the GDSC is still up (same gate as w2). It switches
+	 * the CCI0 RCG source from XO to PLL0_OUT_EVEN/16 (37.5 MHz) via the cached
+	 * clk_rcg2_shared_set_rate handshake, then rolls the RCG back. No PLL/RCG M/N
+	 * register is touched; it does NOT gate the w1 verdict. */
+	if (gdsc_up && branch_up) {
+		pc_w6_update_diag();
+	}
+
+	/* 4. Rollback in reverse order, always. Restore the exact values read
+	 * before the probe, so no camera state is left changed by a diagnostic. */
+	pc_step("w1 rollback", PC_CAMCC_PA + PC_GDSCR);
+	if (w2_ran) {
+		pc_wr(pc_camcc, PC_CCI0_CBCR, cci0_0);
+		/* Read while the GDSC is still up — the same condition as the
+		 * before/after reads — so the RCG comparison is meaningful.
+		 * w2 never writes CMD_RCGR; if the hardware does not re-park the
+		 * root on branch disable, the probe has left state behind and
+		 * must say so rather than claiming a clean rollback. */
+		cmd_restored = pc_rd(pc_camcc, PC_CCI0_CMD_RCGR);
+		cfg_restored = pc_rd(pc_camcc, PC_CCI0_CFG_RCGR);
+		root_reparked = (cmd_restored & PC_CMD_ROOT_OFF) != 0;
+		w2_clean = root_reparked && (cmd_restored == cmd0) &&
+		    (cfg_restored == cfg0);
+		printf("PANDORA CAMERA: C-2b-w3 cleanup: cmd_rcgr=%#x (before=%#x) "
+		    "cfg_rcgr=%#x (before=%#x) root_reparked=%s -> %s\n",
+		    cmd_restored, cmd0, cfg_restored, cfg0,
+		    root_reparked ? "yes" : "no",
+		    w2_clean ? "CLEAN" : "LEFTOVER (probe changed CCI0 RCG state)");
+	}
+	pc_wr(pc_camcc, PC_CAM_TOP_AHB_CBCR, top0);
+	pc_wr(pc_camcc, PC_CORE_AHB_CBCR, core0);
+	pc_wr(pc_camcc, PC_GDSCR, gdscr0);
+	/* Upstream gdsc_disable() polls CFG_GDSCR POWER_DOWN_COMPLETE (bit 15).
+	 * A single read is not proof the domain returned to OFF. */
+	down_ret = pc_wait_gdsc_down();
+	if (down_ret) {
+		printf("PANDORA CAMERA: w1 GDSC-DOWN ERROR %d (power-down complete never observed)\n",
+		    down_ret);
+	} else {
+		power_down_ok = true;
+	}
+	gdscr_now = pc_rd(pc_camcc, PC_GDSCR);
+	cfg = pc_rd(pc_camcc, PC_CFG_GDSCR);
+	/* Compare software control bits only. GDSCR high bits are live hardware
+	 * status and never read back the written value (PC_GDSCR_CTRL_MASK). */
+	restored = (((gdscr_now ^ gdscr0) & PC_GDSCR_CTRL_MASK) == 0) &&
+	    (pc_rd(pc_camcc, PC_CORE_AHB_CBCR) == core0) &&
+	    (pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR) == top0) &&
+	    (!w2_ran || (pc_rd(pc_camcc, PC_CCI0_CBCR) == cci0_0));
+	printf("PANDORA CAMERA: w1 rollback: gdscr=%#x ctrl_mask=%#x cfg_gdscr=%#x "
+	    "(power_down_bit=%s) core_ahb=%#x cam_top_ahb=%#x cci0_cbcr=%#x "
+	    "restored=%s power_down=%s\n",
+	    gdscr_now, PC_GDSCR_CTRL_MASK, cfg,
+	    (cfg & PC_CFG_GDSC_PWR_DOWN) ? "set" : "clear",
+	    pc_rd(pc_camcc, PC_CORE_AHB_CBCR), pc_rd(pc_camcc, PC_CAM_TOP_AHB_CBCR),
+	    pc_rd(pc_camcc, PC_CCI0_CBCR),
+	    restored ? "yes" : "NO", power_down_ok ? "yes" : "NO");
+	if (w2_ran) {
+		/* Cross-check after the GDSC is off: C-2b-p read 0x80000000 for
+		 * CMD_RCGR in that state. Read-only; no RCG write. */
+		printf("PANDORA CAMERA: w3 post-GDSC-off cmd_rcgr=%#x cfg_rcgr=%#x "
+		    "(C-2b-p baseline 0x80000000)\n",
+		    pc_rd(pc_camcc, PC_CCI0_CMD_RCGR),
+		    pc_rd(pc_camcc, PC_CCI0_CFG_RCGR));
+	}
+	if (core_ahb_stuck) {
+		printf("PANDORA CAMERA: w1 CORE_AHB enable_stuck: BIT(0) did not read back; "
+		    "unresolved observation, NOT a success. It is reported separately and "
+		    "does not enter the verdict, whose target is the GDSC + CAM_TOP_AHB path.\n");
+	}
+	printf("PANDORA CAMERA: C-2b-w1 result: gdsc_up=%s branch_up=%s restored=%s "
+	    "power_down=%s core_ahb_enable_stuck=%s w2_cleanup=%s%s\n",
+	    gdsc_up ? "yes" : "no", branch_up ? "yes" : "no",
+	    restored ? "yes" : "no", power_down_ok ? "yes" : "no",
+	    core_ahb_stuck ? "YES" : "no",
+	    w2_ran ? (w2_clean ? "CLEAN" : "LEFTOVER") : "n/a",
+	    (gdsc_up && branch_up && restored && power_down_ok) ? " -> PASS" : " -> NOT PASS");
+}
+
+static void
+pc_tlmm_dump(void)
+{
+	/* CCI I2C SDA/SCL pins (DT pinctrl cci0/1/2): mux function is
+	 * cci_i2c_sdaN / sclN. TLMM CTL: func [5:2]. Print the current CTL so
+	 * a later mux step has a before-picture. No pin is driven here. */
+	static const uint8_t pins[] = {109, 110, 111, 112, 113, 114, 107, 160, 108, 149, 115, 116,
+	    89, 106, 92, 105};
+	printf("PANDORA CAMERA: TLMM CCI/sensor pins (ctl/value):\n");
+	for (unsigned i = 0; i < sizeof(pins); i++) {
+		printf("PANDORA CAMERA:   gpio%u ctl=%#x val=%#x\n", pins[i],
+		    pc_rd(pc_tlmm, PC_GPIO(pins[i])), pc_rd(pc_tlmm, PC_GPIO(pins[i]) + 4));
+	}
+}
+
+static void
+pc_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	unsigned delay_s = 0;
+	(void)PE_parse_boot_argn("pandora_camera_delay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("pandora_steps", &pc_steps_ms, sizeof(pc_steps_ms));
+	if (delay_s) {
+		printf("PANDORA CAMERA: waiting %u s before read-only diag\n", delay_s);
+		pc_sleep(delay_s * 1000u);
+	}
+	/* No GCC map: the GPU/touch drivers already map 0x100000 and report its vote; a second
+	 * unmappable mapping of the same aperture plus a later unmap unmaps the shared window. */
+	pc_step("CAMCC", PC_CAMCC_PA);
+	pc_camcc = ml_io_map_unmappable(PC_CAMCC_PA, 0x80000, VM_WIMG_IO);
+	pc_step("BDISTMCLKCC", PC_BDISTM_PA);
+	pc_bdistm = ml_io_map_unmappable(PC_BDISTM_PA, 0x6000, VM_WIMG_IO);
+	pc_step("TLMM", PC_TLMM_PA);
+	pc_tlmm = ml_io_map_unmappable(PC_TLMM_PA, 0xb0000, VM_WIMG_IO);
+	if (!pc_camcc || !pc_bdistm || !pc_tlmm) {
+		printf("PANDORA CAMERA: mapping failed camcc=%#llx bdistm=%#llx tlmm=%#llx\n",
+		    (unsigned long long)pc_camcc,
+		    (unsigned long long)pc_bdistm, (unsigned long long)pc_tlmm);
+		goto out;
+	}
+	for (unsigned n = 0; n < 3; n++) {
+		pc_step("CCI", PC_CCI_PA(n));
+		pc_cci[n] = ml_io_map_unmappable(PC_CCI_PA(n), 0x1000, VM_WIMG_IO);
+		if (!pc_cci[n]) {
+			printf("PANDORA CAMERA: CCI%u mapping failed\n", n);
+			continue;
+		}
+		pc_cci_dump(n);
+	}
+	pc_camcc_dump();
+	pc_tlmm_dump();
+	/* DT strap dump (not MMIO): which sensor would be read first, and what
+	 * its rails cost. Values are the live DT's, already cross-checked by
+	 * resolving each *-supply phandle to its regulator node. */
+	printf("PANDORA CAMERA: sensor0 (wide, ovx10500u 0x20) CCI0 master1 csiphy0 mclk=gpio89 rst=gpio106 "
+	    "vana=GPIO107 2.8V vdig=GPIO107 0.95V vaf=GPIO116 3.3V vio=L5M_E1 1.8V bob=B1B_E0 bob2=B2B_E0\n");
+	printf("PANDORA CAMERA: sensor3 (tele, s5khpe 0x5a) CCI0 master0 csiphy3 mclk=gpio92 rst=gpio105 "
+	    "vana=GPIO113 2.2V vdig=GPIO113 0.95V vio=L5M_E1 vaf=L5N_E1 3.3V custom1=L3N_E1\n");
+	printf("PANDORA CAMERA: sensor (ultra, s5kjn5 0x7a) no live-DT node; front (ov50m) not in this run\n");
+	printf("PANDORA CAMERA: C-2a diag done (read-only), 3 rear sensors recorded; vendor config not downloaded; "
+	    "C-2a issued no rail vote and no write\n");
+	/* All read-only evidence (C-2a, C-2b-p, C-2b-w0) is printed before the
+	 * first write, so a restart can be attributed to a named w1 step. */
+	pc_clock_probe();
+	pc_w0_dump();
+	pc_w4_pll_snapshot();
+	pc_w1_bringup();
+	printf("PANDORA CAMERA: C-2b-w1 thread done\n");
+out:
+	/* Deliberately no unmaps anywhere in this file: a one-shot boot diagnostic shares
+	 * the TLMM/CCI apertures with the worker threads (and the GCC aperture already taught
+	 * the lesson), so the maps stay for the whole boot, like the other pandora drivers. */
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+pandora_camera_init(void)
+{
+	(void)PE_parse_boot_argn("pandora_camera", &pc_level, sizeof(pc_level));
+	if (!pc_level) {
+		return;
+	}
+	if (pc_started) {
+		return;
+	}
+	pc_started = true;
+	thread_t thread;
+	if (kernel_thread_start(pc_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("PANDORA CAMERA: diag thread allocation failed\n");
+	}
+}
+#endif /* PANDORA */
