+#if defined(PANDORA)
+/* RAM-only boots never initialize UFS, which installs the normal log/reset
+ * hook. UFS replaces this storage-independent fallback when it is ready. */
+static int
+songyuan_ram_restart(unsigned int type)
+{
+    if (type != kPEHaltCPU && type != kPERestartCPU &&
+        type != kPEPanicRestartCPU && type != kPEPanicRestartCPUNoCallouts) {
+        return 0;
+    }
+    register uint64_t x0 __asm__("x0") = 0x84000009ULL;
+    __asm__ volatile("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+    for (;;) {
+        __builtin_arm_wfe();
+    }
+}
+#endif
+
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
 
@@ -76,6 +94,14 @@
 	if (!IODTPlatformExpert::start(provider)) {
