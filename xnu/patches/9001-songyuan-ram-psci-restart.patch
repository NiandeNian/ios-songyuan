+    if (PE_parse_boot_argn("songyuan", &songyuan, sizeof(songyuan)) &&
+        songyuan == 1 && PE_halt_restart == NULL) {
+        PE_halt_restart = songyuan_ram_restart;
+        IOLog("SONGYUAN: RAM-only PSCI restart fallback installed\n");
+    }
+#endif
